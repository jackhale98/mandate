// Sample policy families for tests (not a content pack: the first pack is
// F4). Loaded beside the base pack as `zz_test/policy_families/…`, with
// `test_families.ftl` as `zz_test/locale/en/…`. They follow the contract's
// worked examples (M6_ENGINE_CONTRACTS §2.16, §2.17) with triggers that hold
// in most towns, so simulation tests see instances open.
{
  "kind": "policy_families",
  "items": [
    {
      "id": "family.test_flood_wall",
      "name_key": "family-test-flood-wall",
      "desc_key": "family-test-flood-wall-desc",
      "tier": "local", "category": "environment", "requires": "propose_ordinance",
      "draw": { "rarity": "always", "weight": 2 },
      "max_instances": 2,
      "slots": [
        { "id": "hood", "bind": { "type": "neighborhood", "hazard": "flood", "pick": "most_exposed" } },
        { "id": "hazard", "bind": { "type": "hazard", "hazards": ["flood", "storm"], "in_slot": "hood", "pick": "most_exposed" } },
        { "id": "residents", "bind": { "type": "person", "occupations": ["occupation.organiser", "occupation.clergy"], "in_slot": "hood", "fallback": "executive" }, "optional": true },
        { "id": "builders", "bind": { "type": "person", "occupations": ["occupation.business_leader"], "fallback": "broker" }, "optional": true },
      ],
      "trigger": {
        "any": [
          { "type": "disaster", "within_months": 36 },
          { "type": "hood_hazard", "slot": "hood", "hazard": "flood", "min": 0.0 },
        ],
        "reason_key": "reason-test-flood-risk",
      },
      "expiry": { "grace_months": 6, "cooldown_months": 12 },
      "base": {
        "params": [ { "id": "height", "name_key": "param-test-wall-height", "min": 1, "max": 3, "default": 2, "step": 1, "unit_key": "unit-test-level" } ],
        "cost": { "per_capita_per_unit": 110, "param": "height" },
        "mechanisms": [ { "type": "hazard_protection", "hazard": "@hazard", "param": "height", "per_unit": 0.25 } ],
        "implementation_months": 12,
        "signature": { "environment": 0.2, "law_and_order": 0.2, "localism": 0.2 },
        "secondary_keys": ["secondary-test-wall-river-view"],
        "side_effects": [ { "type": "disruption", "per_unit": 0.04, "param": "height" } ],
        "works": { "kind": "flood_wall", "at": "hood", "contractor_risk": 0.02 },
      },
      "axes": [
        { "id": "where", "name_key": "axis-test-where", "default": "hood",
          "options": [
            { "id": "hood", "name_key": "opt-test-wall-hood", "desc_key": "opt-test-wall-hood-desc",
              "area": { "type": "slot", "slot": "hood" } },
            { "id": "riverfront", "name_key": "opt-test-wall-riverfront", "desc_key": "opt-test-wall-riverfront-desc",
              "area": { "type": "slot_and_adjacent", "slot": "hood" }, "months": 6 },
          ] },
        { "id": "builder", "name_key": "axis-test-who-builds", "default": "works_team",
          "options": [
            { "id": "works_team", "name_key": "opt-test-works-team", "desc_key": "opt-test-works-team-desc" },
            { "id": "contractor", "name_key": "opt-test-contractor", "desc_key": "opt-test-contractor-desc",
              "cost_factor": 1.25, "months": -6,
              "side_effects": [ { "type": "grievance", "class": "low", "per_unit": 0.01, "param": "height" } ] },
            { "id": "landowners", "name_key": "opt-test-landowners", "desc_key": "opt-test-landowners-desc",
              "cost_factor": 0.4, "effect_factor": 0.7, "months": 6,
              "side_effects": [ { "type": "grievance", "class": "high", "min_age_band": 2, "per_unit": 0.03, "param": "height" } ] },
          ] },
      ],
      "sponsors": [
        { "id": "residents", "slot": "residents", "name_key": "sponsor-test-residents",
          "preset": { "where": "riverfront", "builder": "works_team" }, "params": { "height": 3 },
          "price": { "type": "endorsement", "area": { "type": "slot", "slot": "hood" }, "approval": 0.04, "backlash": 0.01 } },
        { "id": "builders", "slot": "builders", "name_key": "sponsor-test-builders",
          "preset": { "where": "hood", "builder": "contractor" }, "params": { "height": 2 },
          "price": { "type": "favour", "count": 1, "context_key": "favour-test-contract" } },
      ],
      "knowledge": {
        "heard": [ { "type": "overheard", "at": ["diner", "market"] }, { "type": "action", "action": "canvass", "slot": "hood" } ],
        "known": [ { "type": "meet", "slot": "residents" }, { "type": "action", "action": "town_hall", "slot": "hood" } ],
        "detailed": [ { "type": "service", "service": "town_data_detailed" } ],
        "lead": { "key": "lead-test-flood-wall", "to": { "type": "streets", "slot": "hood" } },
      },
    },
    {
      "id": "family.test_plant_rescue",
      "name_key": "family-test-plant-rescue",
      "desc_key": "family-test-plant-rescue-desc",
      "tier": "local", "category": "economic_development", "requires": "propose_ordinance",
      "draw": { "rarity": "always", "weight": 3 },
      "slots": [
        { "id": "plant", "bind": { "type": "place", "kinds": ["factory", "mill", "mine", "port"], "pick": "most_at_risk" } },
        { "id": "sector", "bind": { "type": "sector", "of_slot": "plant" } },
        { "id": "owner", "bind": { "type": "person", "occupations": ["occupation.plant_manager"], "at_slot": "plant", "fallback": "broker" } },
        { "id": "union", "bind": { "type": "person", "occupations": ["occupation.union_steward"] }, "optional": true },
      ],
      "trigger": {
        "all": [ { "type": "place_open", "slot": "plant" } ],
        "any": [
          { "type": "sector_decline", "slot": "sector", "min": 0.0 },
          { "type": "crisis", "kind": "crisis.plant_closure" },
        ],
        "reason_key": "reason-test-plant-at-risk",
      },
      "expiry": {
        "when": { "any": [ { "type": "place_closed", "slot": "plant" } ], "reason_key": "reason-test-plant-closed" },
        "grace_months": 3, "max_months": 24, "cooldown_months": 24,
      },
      "base": {
        "params": [ { "id": "aid", "name_key": "param-test-wage-aid", "min": 2, "max": 12, "default": 5, "step": 1, "unit_key": "unit-test-percent" } ],
        "cost": { "per_capita_per_unit": 8, "param": "aid" },
        "mechanisms": [ { "type": "sector_subsidy", "sector": "@sector", "param": "aid", "elasticity": 1.4 } ],
        "implementation_months": 3,
        "signature": { "localism": 0.3, "redistribution": 0.2, "tradition": 0.1 },
        "secondary_keys": ["secondary-test-rescue-precedent"],
        "side_effects": [ { "type": "grievance", "class": "high", "per_unit": 0.006, "param": "aid" } ],
      },
      "axes": [
        { "id": "terms", "name_key": "axis-test-rescue-terms", "default": "no_strings",
          "options": [
            { "id": "no_strings", "name_key": "opt-test-no-strings", "desc_key": "opt-test-no-strings-desc",
              "signature": { "tax_tolerance": -0.1 },
              "side_effects": [ { "type": "grievance", "class": "low", "per_unit": 0.006, "param": "aid" } ] },
            { "id": "job_guarantee", "name_key": "opt-test-guarantee", "desc_key": "opt-test-guarantee-desc",
              "effect_factor": 1.2, "months": 2,
              "signature": { "redistribution": 0.2 },
              "side_effects": [ { "type": "grievance", "class": "high", "per_unit": 0.006, "param": "aid" } ] },
            { "id": "clawback", "name_key": "opt-test-clawback", "desc_key": "opt-test-clawback-desc",
              "cost_factor": 0.75, "effect_factor": 0.85,
              "signature": { "tax_tolerance": 0.1 } },
          ] },
        { "id": "pay", "name_key": "axis-test-paid-by", "default": "budget",
          "options": [
            { "id": "budget", "name_key": "opt-test-pay-budget", "desc_key": "opt-test-pay-budget-desc" },
            { "id": "levy", "name_key": "opt-test-pay-levy", "desc_key": "opt-test-pay-levy-desc",
              "params": [ { "id": "levy", "name_key": "param-test-levy", "min": 0.05, "max": 0.3, "default": 0.1, "step": 0.05, "unit_key": "unit-test-points" } ],
              "mechanisms": [ { "type": "local_tax_rate", "param": "levy" } ],
              "side_effects": [ { "type": "grievance", "min_age_band": 1, "per_unit": 0.4, "param": "levy" } ] },
            { "id": "bond", "name_key": "opt-test-pay-bond", "desc_key": "opt-test-pay-bond-desc",
              "mechanisms": [ { "type": "borrow", "share": 1.0 } ],
              "signature": { "tax_tolerance": 0.1 } },
          ] },
      ],
      "sponsors": [
        { "id": "union", "slot": "union", "name_key": "sponsor-test-union",
          "preset": { "terms": "job_guarantee", "pay": "bond" }, "params": { "aid": 7 },
          "price": { "type": "endorsement", "classes": ["low"], "approval": 0.03, "backlash": 0.02 } },
        { "id": "owner", "slot": "owner", "name_key": "sponsor-test-owner",
          "preset": { "terms": "no_strings", "pay": "budget" }, "params": { "aid": 6 },
          "price": { "type": "favour", "count": 1, "context_key": "favour-test-rescue" } },
      ],
      "knowledge": {
        "heard": [ { "type": "overheard", "at": ["union_hall", "diner", "market"] }, { "type": "visit", "slot": "plant" } ],
        "known": [ { "type": "meet", "slot": "owner" }, { "type": "meet", "slot": "union" } ],
        "detailed": [ { "type": "service", "service": "budget_papers" } ],
        "lead": { "key": "lead-test-plant-rescue", "to": { "type": "slot", "slot": "union" },
                  "else": { "key": "lead-test-plant-rescue-hall", "to": { "type": "place_kind", "kind": "union_hall" } } },
      },
    },
    {
      // Structural jobs, income from fees, and works at the bound place.
      "id": "family.test_market",
      "name_key": "family-test-market",
      "desc_key": "family-test-market-desc",
      "tier": "local", "category": "economic_development", "requires": "propose_ordinance",
      "draw": { "rarity": "always", "weight": 1 },
      "slots": [
        { "id": "market", "bind": { "type": "place", "kinds": ["market", "diner"] } },
        { "id": "hood", "bind": { "type": "neighborhood", "of_slot": "market" } },
      ],
      "trigger": { "any": [ { "type": "months_in_play", "min": 0 } ], "reason_key": "reason-test-market" },
      "base": {
        "params": [ { "id": "stalls", "name_key": "param-test-stalls", "min": 0, "max": 120, "default": 30, "step": 10, "unit_key": "unit-test-stalls" } ],
        "cost": { "per_unit": 150, "param": "stalls" },
        "mechanisms": [ { "type": "sector_capacity", "sector": "sector.retail", "param": "stalls", "per_unit": 1.5 } ],
        "implementation_months": 2,
        "signature": { "localism": 0.3, "tax_tolerance": -0.1 },
        "secondary_keys": ["secondary-test-market-vans"],
        "side_effects": [ { "type": "grievance", "min_age_band": 2, "per_unit": 0.0008, "param": "stalls" } ],
        "works": { "kind": "market_stalls", "at": "market", "months": 4 },
      },
      "axes": [
        { "id": "fee", "name_key": "axis-test-market-fee", "default": "low",
          "options": [
            { "id": "low", "name_key": "opt-test-fee-low", "desc_key": "opt-test-fee-low-desc", "effect_factor": 1.2,
              "cost": { "per_capita": 1 } },
            { "id": "high", "name_key": "opt-test-fee-high", "desc_key": "opt-test-fee-high-desc", "effect_factor": 0.8,
              "mechanisms": [ { "type": "revenue", "per_unit": 400, "param": "stalls" } ],
              "side_effects": [ { "type": "grievance", "class": "middle", "per_unit": 0.0005, "param": "stalls" } ] },
          ] },
      ],
      "knowledge": { "public": true, "known": [ { "type": "visit", "slot": "market" } ] },
    },
  ],
}
