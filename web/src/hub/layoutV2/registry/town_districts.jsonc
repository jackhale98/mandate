// District types for town layout v2 (DEC-090, TOWN_GENERATION.md §6.1–6.2).
// Stage A keeps this registry on the client; stage B moves it to
// content/base/town_districts.jsonc with a schema generated from Rust types
// (DEC-053), in this exact shape.
//
// Each engine neighbourhood becomes one district. Among the types whose
// `appears` rules match the neighbourhood (its kind, the town's geography,
// population band and class), one is picked by weighted rendezvous hashing
// on (town seed, neighbourhood id, type id): integer `weight` tickets each.
// Every neighbourhood kind has at least one type with no geography rule, so
// a pick always exists.
//
// streets.pattern: organic | grid | curvy | contour | yards | quay | ribbon.
// streets.block: block width range, tiles; streets.depth: block depth range.
// plots.frontage / plots.depth: building footprint ranges, tiles.
// plots.setback: front-garden rows; plots.joined: share of plots joined to
// the next (no gap); plots.ground: the open ground of its blocks.
// buildings.mix: [filler kind, weight]; density: share of plots built on.
// growth.reserve: share of plots held back for growth (reserved land, §9.2).
// site.prefers / avoids: siting predicates for the district's seed.
{
  "kind": "town_districts",
  "items": [
    // ---- Cores
    {
      "id": "district.old_core",
      "name_key": "district-old_core",
      "appears": { "hood_kinds": ["core"], "weight": 3 },
      "site": { "prefers": ["centre", "low_slope"], "avoids": ["floodplain"], "anchor": "square" },
      "streets": { "pattern": "organic", "block": [9, 13], "depth": [7, 9], "lanes": "back", "max_dead_ends": 1, "style": "asphalt" },
      "plots": { "frontage": [3, 5], "depth": [3, 4], "setback": 0, "joined": 0.85, "ground": "yard" },
      "buildings": { "mix": [["shop", 6], ["terrace", 4]], "storeys": [2, 4], "density": 0.95 },
      "hosts": ["town_hall", "council_chamber", "market", "news_office", "party_office", "hotel", "business_association"],
      "growth": { "reserve": 0.05, "fill": "infill_first", "decline": "boarded" },
      "tags": [],
      "art": { "kit": "kit.old_core", "family": "commercial", "ground": "ground.cobble", "roof": "roof.slate", "walls": ["wall.stone", "wall.render"], "trim_ramps": ["ramp.chalk", "ramp.ochre"], "lamps": "lamp.sodium", "props": "props.core" },
