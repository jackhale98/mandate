{
  "$defs": {
    "BodyDef": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/DecisionRule"
        },
        "id": {
          "type": "string"
        },
        "name_key": {
          "type": "string"
        },
        "powers": {
          "items": {
            "$ref": "#/$defs/Power"
          },
          "type": "array"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "term_years": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name_key",
        "selection",
        "term_years",
        "decision",
        "powers"
      ],
      "type": "object"
    },
    "BudgetCategory": {
      "description": "Budget categories (mirror the finance domain's categories).",
      "enum": [
        "administration",
        "education",
        "health",
        "safety",
        "infrastructure",
        "social",
        "housing",
        "environment",
        "economic_development"
      ],
      "type": "string"
    },
    "ClassKey": {
      "enum": [
        "low",
        "middle",
        "high"
      ],
      "type": "string"
    },
    "Constituency": {
      "oneOf": [
        {
          "const": "ward",
          "description": "One seat per generated ward / district.",
          "type": "string"
        },
        {
          "const": "at_large",
          "description": "The whole jurisdiction.",
          "type": "string"
        }
      ]
    },
    "ConstitutionDef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name_key": {
          "type": "string"
        },
        "tiers": {
          "items": {
            "$ref": "#/$defs/TierDef"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name_key",
        "tiers"
      ],
      "type": "object"
    },
    "CostDef": {
      "additionalProperties": false,
      "properties": {
        "param": {
          "default": null,
          "description": "The parameter the per-unit costs multiply.",
          "type": [
            "string",
            "null"
          ]
        },
        "per_capita": {
          "default": 0.0,
          "description": "Fixed annual cost per resident (price level 1).",
          "format": "double",
          "type": "number"
        },
        "per_capita_per_unit": {
          "default": 0.0,
          "description": "Annual cost per resident per parameter unit.",
          "format": "double",
          "type": "number"
        },
        "per_unit": {
          "default": 0.0,
          "description": "Annual cost per parameter unit (e.g. per dwelling).",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "DecisionRule": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "majority",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "den": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "num": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "supermajority",
              "type": "string"
            }
          },
          "required": [
            "type",
            "num",
            "den"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "unanimity",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "EconomyParams": {
      "additionalProperties": false,
      "description": "Economy and demography parameters (REQ-005).",
      "properties": {
        "base_dwelling_price": {
          "description": "Average dwelling price at price level 1.0.",
          "format": "double",
          "type": "number"
        },
        "birth_rate": {
          "description": "Births per adult aged 18–44 per year.",
          "format": "double",
          "type": "number"
        },
        "commodity_volatility": {
          "description": "Monthly volatility of commodity prices (log scale).",
          "format": "double",
          "type": "number"
        },
        "construction_lag_months": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "death_rates": {
          "description": "Annual death rates: children, 18–29, 30–44, 45–64, 65+.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        },
        "inflation_target": {
          "format": "double",
          "type": "number"
        },
        "migration_rate": {
          "description": "Monthly share of mobile adults who reconsider where they live.",
          "format": "double",
          "type": "number"
        },
        "natural_unemployment": {
          "format": "double",
          "type": "number"
        },
        "neutral_real_rate": {
          "format": "double",
          "type": "number"
        },
        "pension_replacement": {
          "format": "double",
          "type": "number"
        },
        "recession_depth": {
          "description": "Peak fall in global demand during a recession, [min, max].",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "recession_monthly_chance": {
          "description": "Monthly probability that a global recession begins.",
          "format": "double",
          "type": "number"
        },
        "recession_months": {
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "target_vacancy": {
          "format": "double",
          "type": "number"
        },
        "taxes": {
          "$ref": "#/$defs/TaxParams"
        },
        "unemployment_replacement": {
          "description": "Unemployment benefit and pension as a share of the mean wage.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "inflation_target",
        "natural_unemployment",
        "neutral_real_rate",
        "recession_monthly_chance",
        "recession_depth",
        "recession_months",
        "commodity_volatility",
        "birth_rate",
        "death_rates",
        "migration_rate",
        "target_vacancy",
        "construction_lag_months",
        "base_dwelling_price",
        "taxes",
        "unemployment_replacement",
        "pension_replacement"
      ],
      "type": "object"
    },
    "HazardKey": {
      "enum": [
        "flood",
        "storm",
        "wildfire"
      ],
      "type": "string"
    },
    "MechanismDef": {
      "description": "Typed mechanism primitives (DEC-024). Policies never write outcomes\ndirectly; the domain models compute consequences from these.",
      "oneOf": [
        {
          "description": "Raise a service level; `per_unit` = index gain per parameter unit.",
          "properties": {
            "category": {
              "$ref": "#/$defs/BudgetCategory"
            },
            "param": {
              "type": "string"
            },
            "per_unit": {
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "service",
              "type": "string"
            }
          },
          "required": [
            "type",
            "category",
            "param",
            "per_unit"
          ],
          "type": "object"
        },
        {
          "description": "Annual cash transfer per adult in a class, in currency at price level 1.",
          "properties": {
            "class": {
              "$ref": "#/$defs/ClassKey"
            },
            "param": {
              "type": "string"
            },
            "type": {
              "const": "transfer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "class",
            "param"
          ],
          "type": "object"
        },
        {
          "description": "Extra dwellings built per year.",
          "properties": {
            "param": {
              "type": "string"
            },
            "type": {
              "const": "housing_supply",
              "type": "string"
            }
          },
          "required": [
            "type",
            "param"
          ],
          "type": "object"
        },
        {
          "description": "Multiplies private housing starts by (1 + per_unit × param).",
          "properties": {
            "param": {
              "type": "string"
            },
            "per_unit": {
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "zoning",
              "type": "string"
            }
          },
          "required": [
            "type",
            "param",
            "per_unit"
          ],
          "type": "object"
        },
        {
          "description": "Subsidy as a share of a sector's wage bill; jobs respond with `elasticity`.",
          "properties": {
            "elasticity": {
              "format": "double",
              "type": "number"
            },
            "param": {
              "type": "string"
            },
            "sector": {
              "$ref": "#/$defs/SectorKind"
            },
            "type": {
              "const": "sector_subsidy",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sector",
            "param",
            "elasticity"
          ],
          "type": "object"
        },
        {
          "description": "Wage floor as a share above the low-class market wage.",
          "properties": {
            "param": {
              "type": "string"
            },
            "type": {
              "const": "wage_floor",
              "type": "string"
            }
          },
          "required": [
            "type",
            "param"
          ],
          "type": "object"
        },
        {
          "description": "Reduces damage from a hazard by `per_unit` × param (capped at 0.9).",
          "properties": {
            "hazard": {
              "$ref": "#/$defs/HazardKey"
            },
            "param": {
              "type": "string"
            },
            "per_unit": {
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "hazard_protection",
              "type": "string"
            }
          },
          "required": [
            "type",
            "hazard",
            "param",
            "per_unit"
          ],
          "type": "object"
        },
        {
          "description": "Changes the local property tax by `param` percentage points of value.",
          "properties": {
            "param": {
              "type": "string"
            },
            "type": {
              "const": "local_tax_rate",
              "type": "string"
            }
          },
          "required": [
            "type",
            "param"
          ],
          "type": "object"
        }
      ]
    },
    "NamePoolDef": {
      "additionalProperties": false,
      "description": "Syllable-based name generator pool.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NamePoolKind"
        },
        "middles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prefixes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "suffixes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "words": {
          "default": [],
          "description": "Optional whole-word list mixed in with generated names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "prefixes",
        "suffixes"
      ],
      "type": "object"
    },
    "NamePoolKind": {
      "enum": [
        "place",
        "region",
        "given_name",
        "family_name",
        "neighborhood"
      ],
      "type": "string"
    },
    "OfficeDef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name_key": {
          "type": "string"
        },
        "powers": {
          "items": {
            "$ref": "#/$defs/Power"
          },
          "type": "array"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "term_limit": {
          "default": null,
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "term_years": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name_key",
        "selection",
        "term_years",
        "powers"
      ],
      "type": "object"
    },
    "ParamDef": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "format": "double",
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "max": {
          "format": "double",
          "type": "number"
        },
        "min": {
          "format": "double",
          "type": "number"
        },
        "name_key": {
          "type": "string"
        },
        "step": {
          "format": "double",
          "type": "number"
        },
        "unit_key": {
          "description": "Fluent key for the unit label.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name_key",
        "min",
        "max",
        "default",
        "step",
        "unit_key"
      ],
      "type": "object"
    },
    "PolicyTemplate": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/BudgetCategory"
        },
        "cost": {
          "$ref": "#/$defs/CostDef"
        },
        "desc_key": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "implementation_months": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "mechanisms": {
          "items": {
            "$ref": "#/$defs/MechanismDef"
          },
          "type": "array"
        },
        "name_key": {
          "type": "string"
        },
        "params": {
          "items": {
            "$ref": "#/$defs/ParamDef"
          },
          "type": "array"
        },
        "requires": {
          "$ref": "#/$defs/Power",
          "description": "Power required to propose it."
        },
        "secondary_keys": {
          "description": "Fluent keys for at least one secondary effect (REQ-006).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "signature": {
          "description": "Value alignment over the 8 attitude dimensions (DEC-025 anticipated channel).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/TierKey"
        }
      },
      "required": [
        "id",
        "name_key",
        "desc_key",
        "tier",
        "category",
        "params",
        "cost",
        "mechanisms",
        "implementation_months",
        "signature",
        "secondary_keys",
        "requires"
      ],
      "type": "object"
    },
    "Power": {
      "enum": [
        "propose_ordinance",
        "approve_ordinance",
        "veto",
        "override",
        "propose_budget",
        "approve_budget",
        "appoint",
        "set_local_taxes"
      ],
      "type": "string"
    },
    "ProcedureDef": {
      "additionalProperties": false,
      "properties": {
        "deliberation_days": {
          "description": "Days between introduction and the first stage (deliberation).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "`ordinance` or `budget`.",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/StageDef"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "deliberation_days",
        "stages"
      ],
      "type": "object"
    },
    "SectorClass": {
      "enum": [
        "primary",
        "secondary",
        "tertiary",
        "public"
      ],
      "type": "string"
    },
    "SectorDef": {
      "additionalProperties": false,
      "properties": {
        "base_wage": {
          "description": "Mean annual wage per worker at price level 1.0 (currency units).",
          "format": "double",
          "type": "number"
        },
        "base_weight": {
          "description": "Relative weight of this sector's base presence in a generic economy.",
          "format": "double",
          "type": "number"
        },
        "class": {
          "$ref": "#/$defs/SectorClass"
        },
        "cyclicality": {
          "description": "Elasticity of job demand to the global demand cycle.",
          "format": "double",
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SectorKind"
        },
        "name_key": {
          "type": "string"
        },
        "productivity_growth": {
          "description": "Annual productivity growth (fraction).",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name_key",
        "class",
        "kind",
        "base_weight",
        "base_wage",
        "cyclicality",
        "productivity_growth"
      ],
      "type": "object"
    },
    "SectorKind": {
      "description": "Behavioural kind of a sector; exactly one sector per kind (validated).",
      "enum": [
        "agriculture",
        "resources",
        "manufacturing",
        "construction",
        "retail",
        "tourism",
        "knowledge",
        "public"
      ],
      "type": "string"
    },
    "Selection": {
      "oneOf": [
        {
          "properties": {
            "constituency": {
              "$ref": "#/$defs/Constituency"
            },
            "rule": {
              "$ref": "#/$defs/VotingRule"
            },
            "type": {
              "const": "election",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rule",
            "constituency"
          ],
          "type": "object"
        },
        {
          "properties": {
            "office": {
              "type": "string"
            },
            "type": {
              "const": "appointed_by",
              "type": "string"
            }
          },
          "required": [
            "type",
            "office"
          ],
          "type": "object"
        },
        {
          "properties": {
            "body": {
              "type": "string"
            },
            "type": {
              "const": "elected_by_body",
              "type": "string"
            }
          },
          "required": [
            "type",
            "body"
          ],
          "type": "object"
        }
      ]
    },
    "StageDef": {
      "oneOf": [
        {
          "description": "A vote of a body under a decision rule.",
          "properties": {
            "body": {
              "type": "string"
            },
            "rule": {
              "$ref": "#/$defs/DecisionRule"
            },
            "type": {
              "const": "vote",
              "type": "string"
            }
          },
          "required": [
            "type",
            "body",
            "rule"
          ],
          "type": "object"
        },
        {
          "description": "An office signs or vetoes; a veto may be overridden by a body.",
          "properties": {
            "office": {
              "type": "string"
            },
            "override_body": {
              "type": [
                "string",
                "null"
              ]
            },
            "override_rule": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DecisionRule"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "sign",
              "type": "string"
            }
          },
          "required": [
            "type",
            "office"
          ],
          "type": "object"
        }
      ]
    },
    "TaxParams": {
      "additionalProperties": false,
      "properties": {
        "business": {
          "description": "Tax on business output (national tier).",
          "format": "double",
          "type": "number"
        },
        "income": {
          "description": "Effective income tax by class: low, middle, high (national tier).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "property": {
          "description": "Annual property tax as a share of dwelling value (local tier).",
          "format": "double",
          "type": "number"
        },
        "sales": {
          "description": "Sales tax on consumption (regional tier).",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "property",
        "sales",
        "income",
        "business"
      ],
      "type": "object"
    },
    "TierDef": {
      "additionalProperties": false,
      "properties": {
        "balanced_budget": {
          "default": false,
          "description": "Sub-national balanced-budget rule.",
          "type": "boolean"
        },
        "bodies": {
          "items": {
            "$ref": "#/$defs/BodyDef"
          },
          "type": "array"
        },
        "offices": {
          "items": {
            "$ref": "#/$defs/OfficeDef"
          },
          "type": "array"
        },
        "procedures": {
          "items": {
            "$ref": "#/$defs/ProcedureDef"
          },
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/TierKey"
        }
      },
      "required": [
        "tier",
        "bodies",
        "offices",
        "procedures"
      ],
      "type": "object"
    },
    "TierKey": {
      "enum": [
        "local",
        "regional",
        "national"
      ],
      "type": "string"
    },
    "Tuning": {
      "additionalProperties": false,
      "description": "Data-driven tuning parameters (REQ-005).",
      "properties": {
        "burn_in_years": {
          "description": "Years of NPC-only simulation before the player starts (DEC-022).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "late_night_enabled": {
          "description": "Whether the optional Late Night slot is offered.",
          "type": "boolean"
        },
        "standard_slots": {
          "description": "Standard day-part slots per turn (Morning, Afternoon, Evening).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "start_year": {
          "description": "Calendar year the history begins.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "turn_days": {
          "$ref": "#/$defs/TurnDays",
          "description": "Turn lengths in days by phase (DEC-012)."
        }
      },
      "required": [
        "standard_slots",
        "late_night_enabled",
        "turn_days",
        "burn_in_years",
        "start_year"
      ],
