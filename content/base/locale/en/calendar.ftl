## The town calendar (DEC-114): events' names, the facts a turn leaves,
## the days of the week and familiarity's words. Names take `$town`.

cal-market-day = market day
cal-council-night = the council sitting
cal-meeting-night = the residents' meeting
cal-show-1 = the { $town } Show
cal-show-2 = the { $town } summer fair
cal-show-3 = the { $town } Agricultural Show
cal-memorial-1 = the { $town } memorial service
cal-memorial-2 = the remembrance at the town hall
cal-school-term = parents' day at the school
cal-plant-gala = the works gala

# What a turn's occasions were, told in the turn's passage and the news.
event-calendar-held = On { $weekday } { $day } { $month }, { $event } was held { $part }.
event-calendar-attended = On { $weekday } { $day } { $month }, you were at { $event }.
event-calendar-missed = On { $weekday } { $day } { $month }, you were expected at { $event }, and people noticed you were not there.
event-calendar-reported = On { $weekday } { $day } { $month }, { $event } went ahead.

weekday-mon = Monday
weekday-tue = Tuesday
weekday-wed = Wednesday
weekday-thu = Thursday
weekday-fri = Friday
weekday-sat = Saturday
weekday-sun = Sunday
weekdays-mon = Mondays
weekdays-tue = Tuesdays
weekdays-wed = Wednesdays
weekdays-thu = Thursdays
weekdays-fri = Fridays
weekdays-sat = Saturdays
weekdays-sun = Sundays

# How well someone knows the player's face: words, never a count.
familiar-stranger = a stranger
familiar-face = knows your face
familiar-nod = a familiar face
familiar-ours = a regular here, and counts you as one of their own
weekday-short-mon = Mon
weekday-short-tue = Tue
weekday-short-wed = Wed
weekday-short-thu = Thu
weekday-short-fri = Fri
weekday-short-sat = Sat
weekday-short-sun = Sun

# The bar: the day played, with its weekday.
ui-date-weekday = { $weekday } { $day } { $month } { $year }

# Today's "This fortnight" (DEC-114 §5.5).
ui-this-fortnight = This fortnight
ui-cal-row = { $part }, { $place }
ui-cal-expected = You are expected
ui-cal-you-were-there = You were there
ui-cal-here-now = Under way now
ui-cal-went-ahead = Went ahead on { $weekday } { $day } { $month }
ui-cal-next-expected = Next fortnight: { $event }, { $weekday } { $part }, { $place }. You are expected.
ui-cal-go-label = Go to { $event }
cal-cost-goodwill = Staying away costs a little goodwill among those who come.

# The turn's passage: what the fortnight held.
ui-passage-fortnight = This fortnight
