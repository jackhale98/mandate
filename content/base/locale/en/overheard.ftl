## Overheard talk (content/base/overheard.jsonc). Arguments: $town, $hood,
## and what each line's conditions provide ($industry, $jobs, $broker,
## $rival, $player, $subject, $fact, $outlet, $headline).

# A town's industry as residents name it (a noun phrase).
talk-sector-agriculture = the farms
talk-sector-resources = the quarries and the mines
talk-sector-manufacturing = the factories
talk-sector-construction = the building trade
talk-sector-retail = the shops
talk-sector-tourism = the tourist trade
talk-sector-knowledge = the tech firms
talk-sector-public = the council and the hospital

heard-jobs-closure = "Another closure in { $industry }. { $jobs } jobs gone, just like that."
heard-jobs-notices = "More lay-off notices went out at the plant. Everyone's waiting to see who's next."
heard-jobs-industry = "This town lives on { $industry }. When that sneezes, { $hood } catches cold."
heard-jobs-applications = "Three applications this week and not one call back."
heard-jobs-young = "The young ones are all leaving for the city. Can't say I blame them."
heard-jobs-shifts = "They've cut my shifts again. Twenty hours, if I'm lucky."
heard-jobs-broker = "If { $broker } wanted those jobs to stay in { $town }, they'd stay. That's how it works here."

heard-housing-rent = "The rent went up again. My kids can't afford to live here."
heard-housing-viewing = "Forty people turned up to view one flat in { $hood }. Forty."
heard-housing-waterfront = "They're turning the old warehouses by the water into flats nobody from { $hood } can afford."
heard-housing-sofa = "My cousin's been sleeping on our sofa since spring. Nowhere else to go."
heard-housing-damp = "The landlord won't fix the damp, and he knows I can't afford to move."
heard-housing-cranes = "All these cranes over { $town }, and still nothing for ordinary people."

heard-environment-river = "Have you seen the river lately? Something's not right."
heard-environment-weir = "Nobody fishes below the weir any more. You can smell why."
heard-environment-shore = "There was foam all along the shore again this morning."
heard-environment-air = "Some mornings the air tastes of metal. My little one's wheezing again."
heard-environment-washing = "You can't hang washing out in { $hood } any more. It comes back grey."
heard-environment-industry = "I know the wages come from { $industry }. But look at the air we're breathing."
heard-environment-trees = "They cut down the last trees on the high street for parking."
heard-environment-wells = "The farm wells are tasting funny, and there's no river to blame it on."

heard-taxes-bills = "Every bill that comes through the door is bigger than the last."
heard-taxes-pension = "I'm on a pension. Where am I supposed to find another hundred a year?"
heard-taxes-potholes = "We pay more every year, and what do we get? Potholes."
heard-taxes-selling = "The couple next door are selling up. Said the property tax finished them."
heard-taxes-shop = "The rates on the shop went up again. One more rise and I'm closing."
heard-taxes-vote = "Whoever promises to cut the rates gets my vote. Simple as that."

heard-services-library = "The library's on short hours again, and the potholes are back."
heard-services-broke = "They say { $town } is broke. Broke! Where did all the money go?"
heard-services-bins = "The bins weren't collected for two weeks. Rats everywhere."
heard-services-clinic = "Six weeks for an appointment at the clinic. Six weeks."
heard-services-bus = "They cut the late bus. How are night-shift workers meant to get home?"
heard-services-school = "My daughter's class has thirty-four children in it now."

heard-recovery-insurance = "Half the street is still waiting on the insurance. Who's helping us rebuild?"
heard-recovery-waterline = "The water came up to here. You can still see the line on the walls in { $hood }."
heard-recovery-tarps = "Blue tarps on every other roof. It's been months."
heard-recovery-hall = "The church hall's still feeding people. The council? Nowhere to be seen."
heard-recovery-next = "Everyone's asking the same thing: what happens when it comes again?"
heard-recovery-builders = "You can't get a builder for love nor money. They're booked until next year."

heard-player-unknown = "{ $player }? Never heard of them. Are they from round here?"
heard-player-liked = "{ $player } came round { $hood } and actually listened. That's rare."
heard-player-disliked = "{ $player }? All talk. Haven't seen them since the last election."
heard-player-unsure = "{ $player } seems all right. Can't say they've done much for { $hood } yet."
heard-rival-idle = "What has { $rival } actually done? Name one thing."
heard-rival-busy = "Say what you like about { $rival }, they turn up and get things done."
heard-rival-doors = "{ $rival } has been knocking on doors all week. Pushy, but they're out there."
heard-broker-say-so = "Nothing happens in { $town } without { $broker } saying so."

heard-scandal-player = "Did you hear about { $subject } and { $fact }? I always knew there was something."
heard-scandal-player-defended = "All this about { $subject } and { $fact }. The papers will print anything."
heard-scandal-rival = "{ $subject }, mixed up in { $fact }! Who'd have thought it?"
heard-scandal-anyone = "That business with { $subject } and { $fact }. They're all the same, that lot."
heard-news-headline = "Did you see { $outlet }? '{ $headline }.' It's all anyone's on about."
heard-news-doubt = "'{ $headline },' says { $outlet }. I'll believe it when I see it."
