// Overheard talk (DEC-079): what residents say at a diner, market, or union
// hall. Each week each such place draws three lines that hold for its
// neighbourhood (keyed by town, neighbourhood, week, and place; last week's
// lines are avoided where others hold). A line with a `concern` is heard only
// where that concern is among the neighbourhood's top three; the stronger it
// is felt, the likelier the line. Every `when` condition must hold; each adds
// Fluent arguments (see the HeardCondition schema): `$industry` (a sector as
// residents name it, `talk-sector-…`), `$jobs`, `$broker`, `$rival`,
// `$player`, `$subject` and `$fact` (a running scandal), `$outlet` and
// `$headline` (a recent story), `$crisis`. Always: `$town`, `$hood`.
// `teaches` (DEC-091): what hearing the line lets the player hear of, each
// raised to `heard` (see the SubjectDef schema; lines have no roles, so a
// neighbourhood or a place is where the line is heard): `hood_concerns`,
// `town_concerns`, `broker` (a name, as rumour), `rival_plans`, `place`
// (a tip about a hidden place nearby), `policy_support`, `situational`.
{
  "kind": "overheard",
  "items": [
    // --- Jobs ---------------------------------------------------------------------------
    { "id": "overheard.jobs.closure", "key": "heard-jobs-closure", "concern": "concern.jobs", "weight": 2.5,
      "when": [ { "type": "plant_closure", "within_months": 12 } ], "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.jobs.notices", "key": "heard-jobs-notices", "concern": "concern.jobs", "weight": 2.0,
      "when": [ { "type": "crisis", "kind": "crisis.plant_closure" } ], "teaches": [ { "type": "hood_concerns" }, { "type": "town_concerns" } ] },
    { "id": "overheard.jobs.industry", "key": "heard-jobs-industry", "concern": "concern.jobs",
      "when": [ { "type": "industry" } ], "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.jobs.applications", "key": "heard-jobs-applications", "concern": "concern.jobs", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.jobs.young", "key": "heard-jobs-young", "concern": "concern.jobs", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.jobs.shifts", "key": "heard-jobs-shifts", "concern": "concern.jobs", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.jobs.broker", "key": "heard-jobs-broker", "concern": "concern.jobs", "weight": 0.8,
      "when": [ { "type": "broker" } ], "teaches": [ { "type": "hood_concerns" }, { "type": "broker" } ] },

    // --- Housing ------------------------------------------------------------------------
    { "id": "overheard.housing.rent", "key": "heard-housing-rent", "concern": "concern.housing", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.housing.viewing", "key": "heard-housing-viewing", "concern": "concern.housing", "weight": 2.0,
      "when": [ { "type": "crisis", "kind": "crisis.housing_squeeze" } ], "teaches": [ { "type": "hood_concerns" }, { "type": "town_concerns" } ] },
    { "id": "overheard.housing.waterfront", "key": "heard-housing-waterfront", "concern": "concern.housing",
      "when": [ { "type": "water", "feature": "any" } ], "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.housing.sofa", "key": "heard-housing-sofa", "concern": "concern.housing", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.housing.damp", "key": "heard-housing-damp", "concern": "concern.housing", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.housing.cranes", "key": "heard-housing-cranes", "concern": "concern.housing", "teaches": [ { "type": "hood_concerns" } ] },

    // --- Environment --------------------------------------------------------------------
    { "id": "overheard.environment.river", "key": "heard-environment-river", "concern": "concern.environment",
      "when": [ { "type": "water", "feature": "river" } ], "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.environment.weir", "key": "heard-environment-weir", "concern": "concern.environment",
      "when": [ { "type": "water", "feature": "river" } ], "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.environment.shore", "key": "heard-environment-shore", "concern": "concern.environment",
      "when": [ { "type": "water", "feature": "coast" } ], "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.environment.air", "key": "heard-environment-air", "concern": "concern.environment", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.environment.washing", "key": "heard-environment-washing", "concern": "concern.environment", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.environment.industry", "key": "heard-environment-industry", "concern": "concern.environment",
      "when": [ { "type": "industry" } ], "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.environment.trees", "key": "heard-environment-trees", "concern": "concern.environment", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.environment.wells", "key": "heard-environment-wells", "concern": "concern.environment",
      "when": [ { "type": "dry" } ], "teaches": [ { "type": "hood_concerns" } ] },

    // --- Taxes --------------------------------------------------------------------------
    { "id": "overheard.taxes.bills", "key": "heard-taxes-bills", "concern": "concern.taxes", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.taxes.pension", "key": "heard-taxes-pension", "concern": "concern.taxes", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.taxes.potholes", "key": "heard-taxes-potholes", "concern": "concern.taxes", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.taxes.selling", "key": "heard-taxes-selling", "concern": "concern.taxes", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.taxes.shop", "key": "heard-taxes-shop", "concern": "concern.taxes", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.taxes.vote", "key": "heard-taxes-vote", "concern": "concern.taxes", "weight": 1.5,
      "when": [ { "type": "election_within", "days": 180 } ], "teaches": [ { "type": "hood_concerns" } ] },

    // --- Public services ----------------------------------------------------------------
    { "id": "overheard.services.library", "key": "heard-services-library", "concern": "concern.services", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.services.broke", "key": "heard-services-broke", "concern": "concern.services", "weight": 2.0,
      "when": [ { "type": "crisis", "kind": "crisis.fiscal_hole" } ], "teaches": [ { "type": "hood_concerns" }, { "type": "town_concerns" } ] },
    { "id": "overheard.services.bins", "key": "heard-services-bins", "concern": "concern.services", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.schools_health.clinic", "key": "heard-services-clinic", "concern": "concern.schools_health", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.services.office", "key": "heard-services-office", "concern": "concern.services", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.services.bus", "key": "heard-services-bus", "concern": "concern.services", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.schools_health.school", "key": "heard-services-school", "concern": "concern.schools_health", "teaches": [ { "type": "hood_concerns" } ] },

    // --- The DEC-106 worries ---------------------------------------------------------
    // The cost of living.
    { "id": "overheard.cost_of_living.shop", "key": "heard-cost-shop", "concern": "concern.cost_of_living", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.cost_of_living.wages", "key": "heard-cost-wages", "concern": "concern.cost_of_living", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.cost_of_living.heating", "key": "heard-cost-heating", "concern": "concern.cost_of_living", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.cost_of_living.bills", "key": "heard-cost-bills", "concern": "concern.cost_of_living", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.cost_of_living.treat", "key": "heard-cost-treat", "concern": "concern.cost_of_living", "teaches": [ { "type": "hood_concerns" } ] },
    // Newcomers and change (DEC-106: change, never blame).
    { "id": "overheard.newcomers.faces", "key": "heard-newcomers-faces", "concern": "concern.newcomers", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.newcomers.school_gate", "key": "heard-newcomers-school-gate", "concern": "concern.newcomers", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.newcomers.welcome", "key": "heard-newcomers-welcome", "concern": "concern.newcomers", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.newcomers.house_prices", "key": "heard-newcomers-house-prices", "concern": "concern.newcomers", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.newcomers.old_place", "key": "heard-newcomers-old-place", "concern": "concern.newcomers", "teaches": [ { "type": "hood_concerns" } ] },
    // Young people leaving and an ageing town.
    { "id": "overheard.young_leaving.kids", "key": "heard-young-kids", "concern": "concern.young_leaving", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.young_leaving.club", "key": "heard-young-club", "concern": "concern.young_leaving", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.young_leaving.grey", "key": "heard-young-grey", "concern": "concern.young_leaving", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.young_leaving.school_rolls", "key": "heard-young-school-rolls", "concern": "concern.young_leaving", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.young_leaving.grandchildren", "key": "heard-young-grandchildren", "concern": "concern.young_leaving", "teaches": [ { "type": "hood_concerns" } ] },
    // Schools and health care.
    { "id": "overheard.schools_health.waiting", "key": "heard-care-waiting", "concern": "concern.schools_health", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.schools_health.teachers", "key": "heard-care-teachers", "concern": "concern.schools_health", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.schools_health.pharmacy", "key": "heard-care-pharmacy", "concern": "concern.schools_health", "teaches": [ { "type": "hood_concerns" } ] },
    // Roads and upkeep.
    { "id": "overheard.upkeep.potholes", "key": "heard-upkeep-potholes", "concern": "concern.upkeep", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.upkeep.lights", "key": "heard-upkeep-lights", "concern": "concern.upkeep", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.upkeep.drains", "key": "heard-upkeep-drains", "concern": "concern.upkeep", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.upkeep.pavement", "key": "heard-upkeep-pavement", "concern": "concern.upkeep", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.upkeep.playground", "key": "heard-upkeep-playground", "concern": "concern.upkeep", "teaches": [ { "type": "hood_concerns" } ] },
    // Trust in the town hall.
    { "id": "overheard.trust.all_same", "key": "heard-trust-all-same", "concern": "concern.trust", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.trust.court", "key": "heard-trust-court", "concern": "concern.trust", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.trust.scandal", "key": "heard-trust-scandal", "concern": "concern.trust", "weight": 1.5,
      "when": [ { "type": "scandal" } ], "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.trust.paper", "key": "heard-trust-paper", "concern": "concern.trust", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.trust.vote", "key": "heard-trust-vote", "concern": "concern.trust", "teaches": [ { "type": "hood_concerns" } ] },
    // Development and the town's character.
    { "id": "overheard.development.cranes", "key": "heard-development-cranes", "concern": "concern.development", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.development.field", "key": "heard-development-field", "concern": "concern.development", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.development.dust", "key": "heard-development-dust", "concern": "concern.development", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.development.views", "key": "heard-development-views", "concern": "concern.development", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.development.traffic", "key": "heard-development-traffic", "concern": "concern.development", "teaches": [ { "type": "hood_concerns" } ] },

    // --- Rebuilding after a disaster -----------------------------------------------------
    { "id": "overheard.recovery.insurance", "key": "heard-recovery-insurance", "concern": "concern.recovery", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.recovery.waterline", "key": "heard-recovery-waterline", "concern": "concern.recovery", "weight": 1.5,
      "when": [ { "type": "water", "feature": "any" }, { "type": "disaster", "within_months": 24 } ], "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.recovery.tarps", "key": "heard-recovery-tarps", "concern": "concern.recovery",
      "when": [ { "type": "disaster", "within_months": 24 } ], "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.recovery.hall", "key": "heard-recovery-hall", "concern": "concern.recovery", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.recovery.next", "key": "heard-recovery-next", "concern": "concern.recovery", "teaches": [ { "type": "hood_concerns" } ] },
    { "id": "overheard.recovery.builders", "key": "heard-recovery-builders", "concern": "concern.recovery", "teaches": [ { "type": "hood_concerns" } ] },

    // --- About the player and the rival ----------------------------------------------------
    { "id": "overheard.player.unknown", "key": "heard-player-unknown", "weight": 0.7,
      "when": [ { "type": "player_awareness", "max": 0.12 } ] },
    { "id": "overheard.player.liked", "key": "heard-player-liked",
      "when": [ { "type": "player_approval", "min": 0.12 } ] },
    { "id": "overheard.player.disliked", "key": "heard-player-disliked",
      "when": [ { "type": "player_approval", "max": -0.12 } ] },
    { "id": "overheard.player.unsure", "key": "heard-player-unsure", "weight": 0.7,
      "when": [ { "type": "player_approval", "min": -0.12, "max": 0.12 } ] },
    { "id": "overheard.rival.idle", "key": "heard-rival-idle", "weight": 0.8,
      "when": [ { "type": "rival_record", "max": 0.3 } ], "teaches": [ { "type": "rival_plans" } ] },
    { "id": "overheard.rival.busy", "key": "heard-rival-busy", "weight": 0.8,
      "when": [ { "type": "rival_record", "min": 0.55 } ], "teaches": [ { "type": "rival_plans" } ] },
    { "id": "overheard.rival.doors", "key": "heard-rival-doors", "weight": 1.2,
      "when": [ { "type": "rival" }, { "type": "election_within", "days": 120 } ], "teaches": [ { "type": "rival_plans" } ] },
    { "id": "overheard.broker.say_so", "key": "heard-broker-say-so", "weight": 0.6,
      "when": [ { "type": "broker" } ], "teaches": [ { "type": "broker" } ] },

    // --- Proposals on the table (DEC-092 §2.7) ---------------------------------------------
    // Talk of an open policy-family proposal in the town, heard where its
    // `overheard` hook says (arriving there teaches the proposal at `heard`;
    // these lines are what people say about it). `proposal` gives
    // `$proposal_<slot>` for the family's places and neighbourhoods and
    // `$proposal_<slot>_key` for its sectors and hazards; never a person.
    { "id": "overheard.proposal.plant_rescue", "key": "heard-proposal-plant-rescue", "weight": 2.5,
      "when": [ { "type": "proposal", "family": "family.plant_rescue" } ] },
    { "id": "overheard.proposal.closure_response", "key": "heard-proposal-closure-response", "weight": 2.5,
      "when": [ { "type": "proposal", "family": "family.closure_response" } ] },
    { "id": "overheard.proposal.living_wage", "key": "heard-proposal-living-wage", "weight": 2.0,
      "when": [ { "type": "proposal", "family": "family.living_wage_deal" } ] },
    { "id": "overheard.proposal.incubator", "key": "heard-proposal-incubator", "weight": 2.0,
      "when": [ { "type": "proposal", "family": "family.campus_incubator" } ] },
    { "id": "overheard.proposal.mine_safety", "key": "heard-proposal-mine-safety", "weight": 2.0,
      "when": [ { "type": "proposal", "family": "family.mine_safety" } ] },
    { "id": "overheard.proposal.port_expansion", "key": "heard-proposal-port-expansion", "weight": 2.0,
      "when": [ { "type": "proposal", "family": "family.port_expansion" } ] },
    { "id": "overheard.proposal.bed_tax", "key": "heard-proposal-bed-tax", "weight": 2.0,
      "when": [ { "type": "proposal", "family": "family.hotel_bed_tax" } ] },
    { "id": "overheard.proposal.flood_wall", "key": "heard-proposal-flood-wall", "weight": 2.5,
      "when": [ { "type": "proposal", "family": "family.flood_wall" } ] },
    { "id": "overheard.proposal.rebuild", "key": "heard-proposal-rebuild", "concern": "concern.recovery", "weight": 2.5,
      "when": [ { "type": "proposal", "family": "family.rebuild" } ] },
    { "id": "overheard.proposal.farm_water", "key": "heard-proposal-farm-water", "weight": 2.0,
      "when": [ { "type": "proposal", "family": "family.farm_water" } ] },
    { "id": "overheard.proposal.market", "key": "heard-proposal-market", "weight": 2.0,
      "when": [ { "type": "proposal", "family": "family.market_licences" } ] },
    { "id": "overheard.proposal.community_centre", "key": "heard-proposal-community-centre", "weight": 2.0,
      "when": [ { "type": "proposal", "family": "family.community_centre" } ] },
    { "id": "overheard.proposal.park", "key": "heard-proposal-park", "weight": 2.0,
      "when": [ { "type": "proposal", "family": "family.park" } ] },
    { "id": "overheard.proposal.night_buses", "key": "heard-proposal-night-buses", "weight": 2.0,
      "when": [ { "type": "proposal", "family": "family.night_buses" } ] },
    { "id": "overheard.proposal.clinic_hours", "key": "heard-proposal-clinic-hours", "weight": 2.0,
      "when": [ { "type": "proposal", "family": "family.clinic_hours" } ] },
    { "id": "overheard.proposal.clean_air", "key": "heard-proposal-clean-air", "concern": "concern.environment", "weight": 2.0,
      "when": [ { "type": "proposal", "family": "family.clean_air" } ] },
    { "id": "overheard.proposal.rent_relief", "key": "heard-proposal-rent-relief", "concern": "concern.housing", "weight": 2.5,
      "when": [ { "type": "proposal", "family": "family.rent_relief" } ] },
    { "id": "overheard.proposal.fiscal_bridge", "key": "heard-proposal-fiscal-bridge", "weight": 2.5,
      "when": [ { "type": "proposal", "family": "family.fiscal_bridge" } ] },

    // --- Scandals and the news (DEC-034) --------------------------------------------------
    { "id": "overheard.scandal.player", "key": "heard-scandal-player", "weight": 3.0,
      "when": [ { "type": "scandal", "about": "player" } ] },
    { "id": "overheard.scandal.player_defended", "key": "heard-scandal-player-defended", "weight": 2.0,
      "when": [ { "type": "scandal", "about": "player" }, { "type": "player_approval", "min": 0.05 } ] },
    { "id": "overheard.scandal.rival", "key": "heard-scandal-rival", "weight": 2.5,
      "when": [ { "type": "scandal", "about": "rival" } ] },
    { "id": "overheard.scandal.anyone", "key": "heard-scandal-anyone", "weight": 1.2,
      "when": [ { "type": "scandal" } ] },
    { "id": "overheard.news.headline", "key": "heard-news-headline", "weight": 1.2,
      "when": [ { "type": "headline" } ] },
    { "id": "overheard.news.doubt", "key": "heard-news-doubt", "weight": 0.7,
      "when": [ { "type": "headline" } ] },
  ],
}
