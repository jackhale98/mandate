      "deadline_days": 28, "cooldown_days": 365, "scene": "scene.donor_offer",
      "options": [
        { "id": "accept", "label_key": "dilemma-donor-offer-accept", "aftermath_key": "dilemma-donor-offer-accept-after",
          "effects": [
            { "type": "money", "amount": 3000 },
            { "type": "favour", "role": "donor" },
            { "type": "legal_jeopardy", "delta": 3 },
