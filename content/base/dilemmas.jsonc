      "options": [
        { "id": "inspection", "label_key": "dilemma-pollution-inspection", "aftermath_key": "dilemma-pollution-inspection-after",
          "effects": [
            { "type": "opinion", "role": "owner", "delta": -12, "memory": "stood_against_me" },
            { "type": "opinion", "role": "voice", "delta": 12, "memory": "stood_with_me" },
