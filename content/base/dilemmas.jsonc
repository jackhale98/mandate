            { "type": "approval", "classes": [0], "delta": 0.005 },
            { "type": "standing", "delta": -1 } ] },
        { "id": "decline", "default": true, "label_key": "dilemma-workers-campaign-decline", "aftermath_key": "dilemma-workers-campaign-decline-after",
          "effects": [
            { "type": "opinion", "role": "steward", "delta": -10, "memory": "ignored_me" },
            { "type": "approval", "classes": [0], "delta": -0.015 },
            { "type": "approval", "classes": [2], "delta": 0.005 } ] },
      ],
    },
