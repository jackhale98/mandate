// Dilemmas and requests (DEC-077 §4, DEC-032, DEC-033): moments where every
// option costs someone. The director spotlights one when its triggers hold
// on live state in the player's town and its roles can be cast from live
// actors there. It is visible (with every option's trade-offs) from the day
// it appears until its deadline; then the `default` option happens.
//
// Roles (`cast`): broker, rival, mayor, occupation, colleague, creditor,
// bill (a bill before the council), sponsor_of, ward_neighborhood, law (a
// law in force or being built), goal_holder (requests). Fluent arguments:
// each role's name as `$<role>` (a bill or law: its policy name), a person's
// role as `$<role>_role`, plus `$town`, `$crisis` (the live crisis), and
// `$player`.
//
// Effects are real engine changes (DEC-073): opinion (with a memory),
// approval and awareness (by class; ward, town, or a cast neighbourhood),
// money, health, slots, standing, legal_jeopardy, record, favour, repay,
// vote (the council-vote rules apply), rider (a ward project, optionally for
// the ward of a cast councillor, or a sunset on a cast bill), call_in (a
// favour owed to the player repaid on a cast bill), draft. Validation requires at least
// one cost and one benefit per option, and exactly one default.
{
  "kind": "dilemmas",
  "items": [
    // --- Jobs: the plant -------------------------------------------------------------
    {
      "id": "dilemma.plant_layoffs", "category": "significant",
      "title_key": "dilemma-plant-layoffs", "situation_key": "dilemma-plant-layoffs-situation",
      "roles": [
        { "id": "steward", "cast": { "type": "occupation", "occupations": ["occupation.union_steward", "occupation.organiser"] } },
        { "id": "owner", "cast": { "type": "occupation", "occupations": ["occupation.plant_manager", "occupation.business_leader"] } },
        { "id": "hood", "cast": { "type": "ward_neighborhood" } },
      ],
      "triggers": [ { "type": "crisis", "kind": "crisis.plant_closure", "min_severity": 0.05 } ],
      "deadline_days": 35, "cooldown_days": 365, "scene": "scene.plant_layoffs",
      "options": [
        { "id": "back_owner", "label_key": "dilemma-plant-layoffs-back-owner", "aftermath_key": "dilemma-plant-layoffs-back-owner-after",
          "effects": [
            { "type": "opinion", "role": "owner", "delta": 14, "memory": "stood_with_me" },
            { "type": "opinion", "role": "steward", "delta": -14, "memory": "stood_against_me" },
            { "type": "approval", "classes": [0], "delta": -0.02 },
            { "type": "standing", "delta": 3 } ] },
        { "id": "back_workers", "label_key": "dilemma-plant-layoffs-back-workers", "aftermath_key": "dilemma-plant-layoffs-back-workers-after",
          "effects": [
            { "type": "draft", "template": "policy.hardship_fund" },
            { "type": "opinion", "role": "steward", "delta": 14, "memory": "stood_with_me" },
            { "type": "opinion", "role": "owner", "delta": -12, "memory": "stood_against_me" },
            { "type": "approval", "classes": [0], "delta": 0.02 },
            { "type": "approval", "classes": [2], "delta": -0.01 },
            { "type": "standing", "delta": -2 } ] },
        { "id": "broker_talks", "label_key": "dilemma-plant-layoffs-broker-talks", "aftermath_key": "dilemma-plant-layoffs-broker-talks-after",
          "effects": [
            { "type": "slots", "n": 1 }, { "type": "health", "delta": -3 },
            { "type": "opinion", "role": "steward", "delta": 5 },
            { "type": "opinion", "role": "owner", "delta": 5 },
            { "type": "record", "delta": 0.03 } ] },
        { "id": "stay_out", "default": true, "label_key": "dilemma-plant-layoffs-stay-out", "aftermath_key": "dilemma-plant-layoffs-stay-out-after",
          "effects": [
            { "type": "opinion", "role": "steward", "delta": -9, "memory": "ignored_me" },
            { "type": "opinion", "role": "owner", "delta": 3 },
            { "type": "approval", "neighborhood": "hood", "delta": -0.02 } ] },
      ],
    },
    // Part of the plant storyline: the union's campaign after the layoffs.
    {
      "id": "dilemma.workers_campaign", "category": "significant", "storyline_only": true,
