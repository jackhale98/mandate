    // --- A donor's offer (an opportunity: the director times its arrival) ------------------
    {
      "id": "dilemma.donor_offer", "category": "significant", "opportunity": true,
      "title_key": "dilemma-donor-offer", "situation_key": "dilemma-donor-offer-situation",
