        { "id": "bury_report", "label_key": "dilemma-pollution-bury", "aftermath_key": "dilemma-pollution-bury-after",
          "effects": [
            { "type": "opinion", "role": "owner", "delta": 14, "memory": "stood_with_me" },
            { "type": "approval", "classes": [0], "delta": 0.005 },
            { "type": "hidden", "kind": "buried_report", "severity": "misconduct", "evidence": 0.5, "with_role": "owner" } ] },
        { "id": "wait_for_data", "default": true, "label_key": "dilemma-pollution-wait", "aftermath_key": "dilemma-pollution-wait-after",
          "effects": [
            { "type": "opinion", "role": "voice", "delta": -8, "memory": "ignored_me" },
            { "type": "opinion", "role": "owner", "delta": 3 } ] },
      ],
    },
    // --- Building work: a protest about a law being built ---------------------------------
    {
      "id": "dilemma.building_protest", "category": "significant",
