      "id": "interior.council_chamber", "version": 1, "place": "council_chamber", "cols": 13, "rows": 13, "wall_h": 48, "door": 6,
      "light": { "lamp": "white", "night": 0.72, "ceiling": [{ "x": 6, "y": 5 }, { "x": 3, "y": 10 }, { "x": 9, "y": 10 }] },
