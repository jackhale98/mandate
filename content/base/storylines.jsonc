// Storylines (DEC-032): multi-stage arcs cast from live actors in the
// player's town. A storyline starts when its `start` conditions hold and it
// can cast its roles; each stage is reached when its `advance` conditions
// hold (after `wait_days`); a stage with a `decision` presents that dilemma
// (roles the storyline casts carry over by id), and `branches` send the
// player's answer to a stage. Outcomes write back only through the
// decision's options (engine commands). A stage not reached within
// `timeout_days` fades the arc (`faded_key`). `follow_up` may start later
// with the same cast. Storylines persist in saves.
{
  "kind": "storylines",
  "items": [
    // The plant-closure arc: layoffs, the union's campaign, and how it ends.
    { "id": "storyline.plant_closure", "title_key": "story-plant", "faded_key": "story-plant-faded",
      "roles": [
        { "id": "steward", "cast": { "type": "occupation", "occupations": ["occupation.union_steward", "occupation.organiser"] } },
        { "id": "owner", "cast": { "type": "occupation", "occupations": ["occupation.plant_manager", "occupation.business_leader"] } },
        { "id": "hood", "cast": { "type": "ward_neighborhood" } },
      ],
      "start": [ { "type": "crisis", "kind": "crisis.plant_closure", "min_severity": 0.05 } ],
      "cooldown_days": 1095,
      "stages": [
        { "id": "layoffs", "key": "story-plant-layoffs", "decision": "dilemma.plant_layoffs",
          "branches": { "back_owner": "walkout", "back_workers": "organising", "broker_talks": "organising", "stay_out": "organising" } },
        { "id": "walkout", "key": "story-plant-walkout", "wait_days": 21 },
        { "id": "organising", "key": "story-plant-organising", "wait_days": 30, "timeout_days": 300,
          "advance": [ { "type": "goal", "role": "steward", "goal": "goal.organise_workers" } ],
          "decision": "dilemma.workers_campaign" },
        { "id": "resolution", "key": "story-plant-resolution", "ends": true, "wait_days": 60, "timeout_days": 720,
          "advance": [ { "type": "indicator", "indicator": "job_loss", "max": 0.01 } ] },
      ] },
    // The rival arc: once the campaign opens, the rival circles, makes an
    // offer, challenges the player to a debate, and the voters decide. It
    // follows the player: when it ends, it may start again next campaign.
    { "id": "storyline.rival", "title_key": "story-rival", "faded_key": "story-rival-faded",
      "roles": [ { "id": "rival", "cast": { "type": "rival" } } ],
      "start": [ { "type": "campaigning" } ],
      "cooldown_days": 200, "follow_up": "storyline.rival",
      "stages": [
        { "id": "shadow", "key": "story-rival-shadow" },
        { "id": "offer", "key": "story-rival-offer", "wait_days": 5, "timeout_days": 40,
          "decision": "dilemma.rival_offer",
          "branches": { "truce": "pact", "refuse": "showdown", "ignore": "showdown" } },
        { "id": "pact", "key": "story-rival-pact", "wait_days": 7 },
        { "id": "showdown", "key": "story-rival-showdown", "timeout_days": 50,
          "advance": [ { "type": "election_within", "days": 30 } ], "decision": "dilemma.debate_challenge" },
        { "id": "verdict", "key": "story-rival-verdict", "ends": true, "timeout_days": 60,
          "advance": [ { "type": "campaigning", "is": false } ] },
      ] },
    // The favour-debt arc: a debt, a reminder, the bill that calls it in.
    { "id": "storyline.favour_debt", "title_key": "story-favour", "faded_key": "story-favour-faded",
      "roles": [ { "id": "creditor", "cast": { "type": "creditor" } } ],
      "start": [ { "type": "favour", "role": "creditor" } ],
      "cooldown_days": 365,
      "stages": [
        { "id": "debt", "key": "story-favour-debt" },
        { "id": "reminder", "key": "story-favour-reminder", "wait_days": 45, "timeout_days": 400,
          "advance": [ { "type": "favour", "role": "creditor" } ] },
        { "id": "called_in", "key": "story-favour-called-in", "timeout_days": 540,
          "advance": [ { "type": "favour", "role": "creditor" } ],
          "decision": "dilemma.favour_called_in",
          "branches": { "pay_back": "repaid", "refuse": "burned", "dodge": "burned" } },
        { "id": "repaid", "key": "story-favour-repaid", "ends": true },
        { "id": "burned", "key": "story-favour-burned", "ends": true },
      ] },
  ],
}
