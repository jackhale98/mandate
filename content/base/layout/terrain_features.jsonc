// Terrain features for town layout v2 (DEC-090 D4, TOWN_GENERATION.md §6.1).
// Presentation data, validated by the engine and sent to the client's town
// generator (`LayoutContentView`). Types: `mandate-content/src/layout.rs`.
//
// `generator` names the code that draws the feature (an extension point,
// §6.5: river, creek, coast, lake, hills, cliff, woods, marsh, beach);
// `appears` says when it applies (from the geography view); `params` are the
// generator's integer parameters (per mille where a share); `art` names art
// keys, never files (§7.1). The first feature in load order with a given
// generator is the one used.
{
  "kind": "terrain_features",
  "items": [
    {
      "id": "feature.river",
      "generator": "river",
      "appears": { "geo": { "river": true } },
      // Width in tiles by river class 1..3; meander: midpoint displacement as a share of the segment; the
      // floodplain (level 0 band each side) widens with the flood hazard; the valley holds the levels below.
      "params": { "width_by_class": [[2, 3], [4, 6], [7, 9]], "meander_pm": 160, "floodplain": [2, 8], "offset_pm": 140 },
      "art": { "water": "water.river", "edge_urban": "edge.embankment", "edge_rural": "edge.reeds" },
    },
    {
      "id": "feature.creek",
      "generator": "creek",
      "appears": { "geo": { "creeks": true } },
      "params": { "width": 1, "meander_pm": 220, "max": 2 },
      "art": { "water": "water.creek", "ford": "connector.ford", "stones": "prop.stepping_stones" },
    },
    {
      "id": "feature.coast",
      "generator": "coast",
      "appears": { "geo": { "coast": true } },
      // Depth of the sea from the map edge (share of the map), wobble of the shoreline (tiles), bay depth (share).
      "params": { "depth_pm": 200, "wobble": 4, "bay_pm": 120 },
      "art": { "water": "water.sea", "edge_urban": "edge.quay", "edge_rural": "edge.sand" },
    },
    {
      "id": "feature.beach",
      "generator": "beach",
      "appears": { "geo": { "shore": ["beach"] } },
      "params": { "width": [2, 3] },
      "art": { "ground": "ground.sand" },
    },
    {
      "id": "feature.cliff",
      "generator": "cliff",
      "appears": { "geo": { "shore": ["cliff", "rocky"] } },
      "params": { "height_levels": 2, "rock_pm": 600 },
      "art": { "face": "edge.rock_face", "lip": "edge.rock_lip" },
    },
    {
      "id": "feature.lake",
      "generator": "lake",
      "appears": { "geo": { "lake": true } },
      "params": { "radius": [8, 13] },
      "art": { "water": "water.lake", "edge_rural": "edge.reeds" },
    },
    {
      "id": "feature.hills",
      "generator": "hills",
      "appears": { "geo": { "ruggedness_pm": { "min": 150 } } },
      // Ruggedness thresholds (per mille) for 1, 2 and 3 level steps across the map; noise share of the relief.
      "params": { "levels_at": [150, 330, 560], "noise_pm": 450 },
      "art": { "bank": "edge.bank", "wall": "edge.retaining_wall", "lip": "edge.lip", "steps": "connector.steps" },
    },
    {
      "id": "feature.woods",
      "generator": "woods",
      "appears": { "geo": { "woods_pm": { "min": 80 } } },
      "params": { "density_pm": 700, "edge_only": true },
      "art": { "canopy": "foliage.canopy", "tree": "prop.tree", "conifer": "prop.pine" },
    },
    {
      "id": "feature.marsh",
      "generator": "marsh",
      "appears": { "geo": { "river": true, "flood_pm": { "min": 150 } } },
      "params": { "share_pm": 350 },
      "art": { "ground": "ground.reeds", "prop": "prop.reeds" },
    },
  ],
}
