// Federal Presidential Republic (DEC-015 archetype 1; MVP default, DEC-016).
// Built from primitives (DEC-017): the engine reads these rules; nothing is hardcoded.
// Politicians hold these posts (DEC-098): a seat in a body or an office, by id.
// Each post has its own term, limit and (optionally) calendar; `member_key` is
// a body member's role word (Fluent `role-<word>`), an office's id is its own.
// `works_at` is a place kind. The `ordinance` and `budget` procedures are a
// contract with the engine: law-making runs `ordinance`, whose first `vote`
// stage is the tier's legislature and whose `sign` stage is its executive.
{
  "kind": "constitution",
  "value": {
    "id": "constitution.federal_presidential",
    "name_key": "constitution-federal_presidential",
    "tiers": [
      {
        "tier": "local",
        "balanced_budget": true,
        "elections": { "month": 11, "day": 3, "cycle_offset": 0, "campaign_weeks": 8, "timing": "concurrent", "partisan_ballot": true },
        "bodies": [
          {
            "id": "council", "name_key": "body-council", "member_key": "councillor", "works_at": "council_chamber",
            "selection": { "type": "election", "rule": "plurality", "constituency": "ward" },
            "term_years": 4, "decision": { "type": "majority" },
            "powers": ["propose_ordinance", "approve_ordinance", "override", "approve_budget", "set_local_taxes"],
          },
        ],
        "offices": [
          {
            "id": "mayor", "name_key": "office-mayor", "works_at": "town_hall",
            "selection": { "type": "election", "rule": "plurality", "constituency": "at_large" },
            "term_years": 4, "term_limit": 2,
            "powers": ["propose_ordinance", "veto", "propose_budget", "appoint"],
          },
        ],
        "procedures": [
          {
            "id": "ordinance", "deliberation_days": 21,
            "stages": [
              { "type": "vote", "body": "council", "rule": { "type": "majority" } },
              { "type": "sign", "office": "mayor", "override_body": "council", "override_rule": { "type": "supermajority", "num": 2, "den": 3 } },
            ],
          },
          {
            "id": "budget", "deliberation_days": 14,
            "stages": [
              { "type": "vote", "body": "council", "rule": { "type": "majority" } },
              { "type": "sign", "office": "mayor", "override_body": "council", "override_rule": { "type": "supermajority", "num": 2, "den": 3 } },
            ],
          },
        ],
      },
      {
        "tier": "regional",
        "balanced_budget": true,
        "elections": { "month": 11, "day": 3, "cycle_offset": 2, "campaign_weeks": 10, "timing": "concurrent", "partisan_ballot": true },
        "bodies": [
          {
            "id": "assembly", "name_key": "body-regional-assembly", "member_key": "assembly_member", "works_at": "regional_assembly",
            "selection": { "type": "election", "rule": "plurality", "constituency": "ward" },
            "term_years": 4, "decision": { "type": "majority" },
            "powers": ["propose_ordinance", "approve_ordinance", "override", "approve_budget"],
          },
        ],
        "offices": [
          {
            "id": "governor", "name_key": "office-governor", "works_at": "regional_assembly",
            "selection": { "type": "election", "rule": "plurality", "constituency": "at_large" },
            "term_years": 4, "term_limit": 2,
            "powers": ["propose_ordinance", "veto", "propose_budget", "appoint"],
          },
        ],
        "procedures": [
          {
            "id": "ordinance", "deliberation_days": 42,
            "stages": [
              { "type": "vote", "body": "assembly", "rule": { "type": "majority" } },
              { "type": "sign", "office": "governor", "override_body": "assembly", "override_rule": { "type": "supermajority", "num": 2, "den": 3 } },
            ],
          },
          {
            "id": "budget", "deliberation_days": 28,
            "stages": [
              { "type": "vote", "body": "assembly", "rule": { "type": "majority" } },
              { "type": "sign", "office": "governor", "override_body": "assembly", "override_rule": { "type": "supermajority", "num": 2, "den": 3 } },
            ],
          },
        ],
      },
      {
        "tier": "national",
        "balanced_budget": false,
        "elections": { "month": 11, "day": 3, "cycle_offset": 0, "campaign_weeks": 12, "timing": "concurrent", "partisan_ballot": true },
        "bodies": [
          {
            "id": "house", "name_key": "body-house", "member_key": "representative", "works_at": "parliament",
            "selection": { "type": "election", "rule": "plurality", "constituency": "ward" },
            "term_years": 2, "decision": { "type": "majority" },
            "powers": ["propose_ordinance", "approve_ordinance", "override", "approve_budget"],
          },
          {
            "id": "senate", "name_key": "body-senate", "member_key": "senator", "works_at": "parliament", "seats": 30,
            "selection": { "type": "election", "rule": "plurality", "constituency": "at_large" },
            "term_years": 6, "decision": { "type": "majority" },
            "powers": ["approve_ordinance", "override", "approve_budget"],
          },
        ],
        "offices": [
          {
            "id": "president", "name_key": "office-president", "works_at": "executive_residence",
            "selection": { "type": "election", "rule": "plurality", "constituency": "at_large" },
            "term_years": 4, "term_limit": 2,
            "powers": ["veto", "propose_budget", "appoint"],
          },
        ],
        "procedures": [
          {
            "id": "ordinance", "deliberation_days": 60,
            "stages": [
              { "type": "vote", "body": "house", "rule": { "type": "majority" } },
              { "type": "vote", "body": "senate", "rule": { "type": "majority" } },
              { "type": "sign", "office": "president", "override_body": "house", "override_rule": { "type": "supermajority", "num": 2, "den": 3 } },
            ],
          },
          {
            "id": "budget", "deliberation_days": 45,
            "stages": [
              { "type": "vote", "body": "house", "rule": { "type": "majority" } },
              { "type": "vote", "body": "senate", "rule": { "type": "majority" } },
              { "type": "sign", "office": "president", "override_body": "house", "override_rule": { "type": "supermajority", "num": 2, "den": 3 } },
            ],
          },
        ],
      },
    ],
    // The career ladder (DEC-098): acts are not tiers; the presidency is an
    // act of its own (DEC-004).
    "career": {
      "summit": "president",
      "acts": [
        { "id": "act.local", "tier": "local" },
        { "id": "act.regional", "tier": "regional" },
        { "id": "act.national", "tier": "national", "except": ["president"] },
        { "id": "act.summit", "posts": ["president"] },
      ],
    },
  },
}
