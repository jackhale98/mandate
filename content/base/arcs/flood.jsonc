// After the water (DEC-109; STAGED_ARCS §7.2): a flood in a town the
// player is watching, from the day it strikes to the day the struck
// neighbourhood is rebuilt, rebuilt behind a wall, or left as it is.
//
// Built from *struck* (task A1). The *warning* stage and the *passed* exit
// need a forecast before a strike (task A5b) and are not here; nor are the
// town's own money (`treasury`), the government's standing in the
// neighbourhood (`gov_approval`) or boarded houses (`place_state`), which
// their owners add in A5. Until then the money is the player's word in the
// budget, and what it buys is the repairs (`recovery`).
//
// Transitions read; beats write. Nothing a player picks names a stage: the
// edges read the neighbourhood's repairs (`recovered`), the laws in force, and
// the run's marks, heat and days. A story reads who is still away (`displaced`).
//
// Marks: `at_hall` (carried boxes), `sheltered` (the ask kept), `paid_first`
// (the money decision), `crew` (the official sent one); from the meeting
// `dated` (a date given), `tabled` (a draft put in from the floor) and the
// scene's ends `meeting_won`, `meeting_split`, `meeting_lost`, `stayed_away`.
{
  "kind": "arcs",
  "items": [
    {
      "id": "arc.flood", "title_key": "arc-flood", "themes": ["crisis"], "rank": "crisis",
      // A town's matter until `disaster` and `law_in_force` read a region.
      "tiers": ["local"], "cooldown_days": 0,
      "raise": [ { "type": "disaster", "hazard": "flood", "within_months": 1 } ],
      "roles": [
        { "id": "hood", "cast": { "type": "area", "pick": "most_exposed", "hazard": "flood" } },
        { "id": "organiser", "cast": { "type": "occupation", "near": "hood",
            "occupations": ["occupation.organiser", "occupation.clergy", "occupation.nurse", "occupation.shopkeeper", "occupation.teacher"] } },
        { "id": "hall", "cast": { "type": "place", "kinds": ["community_centre", "school", "town_hall"], "near": "hood" } },
        { "id": "official", "cast": { "type": "post", "power": "propose_budget" }, "optional": true },
        { "id": "above", "cast": { "type": "jurisdiction", "pick": "parent" } },
      ],
      // A flood that sent nobody from their home is no story.
      "given": [ { "type": "displaced", "slot": "hood", "min": 0.001 } ],
      "facts": [ { "type": "displaced", "slot": "hood" }, { "type": "recovered", "slot": "hood" } ],
      "sides": { "ally": "organiser", "opponent": "official" },
      "heat": { "start": 0.3, "floor": { "indicator": "recent_disaster", "scale": 0.4 } },
      "answers": ["policy.rebuild_fund", "policy.flood_defenses", "family.rebuild", "family.flood_wall", "policy.hardship_fund"],
      "stages": [
        // The first weeks: the hall, a second roof, and who pays.
        { "id": "struck", "key": "arc-flood-struck", "clock": { "days": [21, 28] },
          "beats": [
            { "id": "press", "type": "press", "headline_key": "headline-arc-flood-struck" },
            { "id": "skips", "type": "heard", "line": "overheard.flood.skips" },
            { "id": "box", "type": "visit", "at": "hall", "verb_key": "visit-arc-flood-box", "outcome_key": "outcome-arc-flood-box",
              "sets": "at_hall", "relief": 0.05,
              "effects": [
                { "type": "opinion", "role": "organiser", "delta": 8, "memory": "stood_with_me" },
                { "type": "approval", "area": "hood", "delta": 0.01 } ] },
            { "id": "shelter", "type": "ask", "template": "ask.flood_shelter", "asker": "organiser", "sets": "sheltered", "relief": 0.05 },
            { "id": "money", "type": "decision", "dilemma": "dilemma.flood_money", "weight": "significant",
              "when": [ { "type": "office", "posts": ["any"] } ],
              "on": {
                "now": { "sets": "paid_first", "heat": -0.1, "effects": [ { "type": "recovery", "area": "hood", "repair": 2.0, "months": 8 } ] },
                "worst": { "sets": "paid_first", "effects": [ { "type": "recovery", "area": "hood", "repair": 1.5, "months": 6 } ] } } },
          ],
          "next": [ { "to": "counting", "clock_within_days": 0 } ] },

        // The water is gone and the weeks are counted.
        { "id": "counting", "key": "arc-flood-counting", "rise": 0.04,
          "beats": [
            { "id": "skips", "type": "heard", "line": "overheard.flood.skips" },
            { "id": "crew", "type": "talk", "with": "official",
              "choice": { "label_key": "talk-arc-flood-crew", "say_key": "talk-arc-flood-crew-say",
                "replies": [
                  { "key": "talk-arc-flood-crew-yes", "agrees": true, "sets": "crew",
                    "when": [ { "type": "any", "of": [
                      { "type": "arc_mark", "mark": "sheltered" },
                      { "type": "favour", "slot": "speaker", "owed_to_player": true },
                      { "type": "opinion", "slot": "speaker", "min": 15 } ] } ],
                    "effects": [ { "type": "recovery", "area": "hood", "repair": 1.5, "months": 3 } ] },
                  // Someone who owes the player nothing sends one for a
                  // favour later: a debt the favour's arc may call in.
                  { "key": "talk-arc-flood-crew-owe", "agrees": true, "sets": "crew",
                    "when": [ { "type": "opinion", "slot": "speaker", "min": -10 } ],
                    "effects": [
                      { "type": "recovery", "area": "hood", "repair": 1.5, "months": 3 },
                      { "type": "favour", "role": "official" } ] },
                  { "key": "talk-arc-flood-crew-no" } ] } },
            { "id": "petition", "type": "move", "actor": "organiser", "weight": 0.4, "line_key": "skip-item-arc-flood-petition",
              "when": [ { "type": "arc_days", "min": 21 }, { "type": "arc_mark", "mark": "paid_first", "is": false }, { "type": "arc_mark", "mark": "crew", "is": false } ],
              "effects": [ { "type": "heat", "delta": 0.1 } ] },
            { "id": "weeks", "type": "press", "headline_key": "headline-arc-flood-weeks",
              "when": [ { "type": "arc_days", "min": 35 }, { "type": "displaced", "slot": "hood", "min": 0.001 } ] },
          ],
          // Work started early does not skip the hall: the street is called
          // to hear the plan, and a player who paid or sent a crew faces a
          // cooler room. Only a law answers the matter without one.
          "next": [
            { "to": "rebuilding", "when": [ { "type": "law_in_force", "templates": ["policy.rebuild_fund", "policy.flood_defenses", "family.rebuild", "family.flood_wall"] } ] },
            { "to": "meeting", "when": [
                { "type": "any", "of": [ { "type": "arc_mark", "mark": "paid_first" }, { "type": "arc_mark", "mark": "crew" } ] },
                { "type": "recovered", "slot": "hood", "min": 0.2 } ] },
            { "to": "meeting", "when": [ { "type": "arc_heat", "min": 0.75 } ] },
            { "to": "meeting", "after_days": 56 } ] },

        // The turn: a full hall, and a question about a date. It is played
        // (DEC-112; EXCHANGE_SCENES §6.4): a hostile meeting of three
        // rounds before the struck neighbourhood by income class and the
        // organiser who called it. The room's temper is the run's heat, so a
        // hot room hears less: owning what went wrong and staying for every
        // question cool it before anything is spent on it. The clock is the
        // meeting's night (at least a turn away: the engine holds a scene's
        // clock to a turn); a player who never came leaves an empty chair.
        // Beside it, the date itself is given to the organiser, in person:
        // a promise with the repairs behind it, as before.
        //
        // How the room ends decides the matter: a hall carried backs the
        // work already started and the street stays; a hall lost, or an
        // empty chair, and the street gives up on the town sooner.
        { "id": "meeting", "key": "arc-flood-meeting", "climax": true, "clock": { "days": [14, 21] },
          "beats": [
            { "id": "room", "type": "exchange", "once": true,
              "at": "hall", "time": "slot",
              "sides": { "other": "organiser" },
              "layout": "crowd",
              "audience": [
                { "from": "classes", "of": "hood", "start": "approval" },
                { "from": "person", "role": "organiser", "start": "opinion" } ],
              "temper": { "reads": "heat", "drag": 0.5 },
              "rounds": 3,
              "prompts": [
                // What was let pass in this arc (an ask left to lapse, an
                // organiser who remembers being ignored), else a promise
                // broken, else the room's question.
                { "round": 1, "from": ["absent", "broken_promise", "top_worry"] },
                { "round": 2, "from": ["governing_record", "failed_law", "top_worry"] },
                { "round": 3, "from": ["top_worry"] } ],
              "moves": ["record", "heard", "act", "own", "offer", "pass"],
              // Carrying boxes at the hall in the first weeks: the room
              // knows the player, and round 1 is not cold.
              "prep": [ { "mark": "at_hall", "removes": "cold" } ],
              "outcome": {
                "won": { "sets": "meeting_won", "heat": -0.25 },
                "split": { "sets": "meeting_split", "heat": -0.10 },
                "lost": { "sets": "meeting_lost", "heat": 0.10 },
                "absent": { "sets": "stayed_away", "heat": 0.20,
                  "effects": [ { "type": "opinion", "role": "organiser", "delta": -8, "memory": "ignored_me" } ] } },
              "text": "exchange-flood" },
            // A date, given to the organiser to put to the hall: the repairs
            // speed up behind it, and the player's name is on it.
            { "id": "date", "type": "talk", "with": "organiser", "sets": "dated",
              "effects": [
                { "type": "recovery", "area": "hood", "repair": 1.5, "months": 6 },
                { "type": "standing", "delta": -2 } ],
              "choice": { "label_key": "talk-arc-flood-date", "say_key": "talk-arc-flood-date-say",
                "replies": [
                  { "key": "talk-arc-flood-date-known", "agrees": true,
                    "when": [ { "type": "arc_mark", "mark": "at_hall" } ] },
                  { "key": "talk-arc-flood-date-yes", "agrees": true } ] } },
          ],
          "next": [
            { "to": "rebuilding", "when": [ { "type": "law_in_force", "templates": ["policy.rebuild_fund", "policy.flood_defenses", "family.rebuild", "family.flood_wall"] } ] },
            { "to": "rebuilding", "when": [ { "type": "arc_scene", "beat": "meeting.room", "outcomes": ["won", "split"] },
                { "type": "recovered", "slot": "hood", "min": 0.2 } ] },
            { "to": "rebuilding", "when": [ { "type": "arc_mark", "mark": "dated" }, { "type": "recovered", "slot": "hood", "min": 0.45 } ] },
            { "to": "hollowed", "after_days": 60, "when": [ { "type": "arc_scene", "beat": "meeting.room", "outcomes": ["lost", "absent"] } ] },
            { "to": "hollowed", "after_days": 120 } ] },

        // Work has started; the question is how it ends.
        { "id": "rebuilding", "key": "arc-flood-rebuilding", "clock": { "days": [240, 300] },
          "beats": [
            { "id": "works", "type": "visit", "at": "hood", "verb_key": "visit-arc-flood-works", "outcome_key": "outcome-arc-flood-works",
              "time": "half", "relief": 0.03, "effects": [ { "type": "approval", "area": "hood", "delta": 0.01 } ] },
            { "id": "wall", "type": "press", "headline_key": "headline-arc-flood-wall",
              "when": [ { "type": "law_in_force", "templates": ["policy.flood_defenses", "family.flood_wall"] } ] },
          ],
          "next": [
            { "to": "defended", "when": [ { "type": "law_in_force", "templates": ["policy.flood_defenses", "family.flood_wall"] }, { "type": "recovered", "slot": "hood", "min": 0.7 } ] },
            { "to": "rebuilt", "when": [ { "type": "recovered", "slot": "hood", "min": 0.85 } ] },
            { "to": "rebuilt", "when": [ { "type": "recovered", "slot": "hood", "min": 0.72 } ], "clock_within_days": 0 },
            { "to": "hollowed", "clock_within_days": 0 } ] },

        // Rebuilt, and a wall voted through.
        { "id": "defended", "key": "arc-flood-defended",
          "exit": { "legacy_key": "legacy-arc-flood-defended", "effects": [
            { "type": "approval", "area": "hood", "delta": 0.03 },
            { "when": [ { "type": "any", "of": [ { "type": "arc_mark", "mark": "meeting_won" }, { "type": "arc_mark", "mark": "meeting_split" } ] } ],
              "type": "approval", "area": "hood", "delta": 0.01 },
            { "when": [ { "type": "arc_mark", "mark": "tabled" } ], "type": "record", "delta": 0.08 },
            { "when": [ { "type": "arc_mark", "mark": "at_hall" } ], "type": "opinion", "role": "organiser", "delta": 6 } ] } },
        // Rebuilt as it was. A player nobody saw is in nobody's memory of it.
        { "id": "rebuilt", "key": "arc-flood-rebuilt",
          "exit": { "legacy_key": "legacy-arc-flood-rebuilt", "effects": [
            { "when": [ { "type": "arc_mark", "mark": "at_hall" } ], "type": "approval", "area": "hood", "delta": 0.03 },
            { "when": [ { "type": "any", "of": [ { "type": "arc_mark", "mark": "meeting_won" }, { "type": "arc_mark", "mark": "meeting_split" } ] } ],
              "type": "approval", "area": "hood", "delta": 0.01 },
            { "when": [ { "type": "arc_mark", "mark": "paid_first" } ], "type": "record", "delta": 0.04 },
            { "when": [ { "type": "arc_mark", "mark": "sheltered" } ], "type": "favour", "role": "organiser", "owed_to_player": true } ] } },
        // The work stopped short: those still away go for good.
        { "id": "hollowed", "key": "arc-flood-hollowed",
          "exit": { "headline_key": "headline-arc-flood-hollowed", "effects": [
            { "type": "displacement", "area": "hood", "of": "still_away" },
            { "type": "approval", "area": "hood", "delta": -0.04 },
            { "when": [ { "type": "arc_mark", "mark": "stayed_away" } ], "type": "approval", "area": "hood", "delta": -0.02 },
            { "when": [ { "type": "arc_mark", "mark": "meeting_lost" } ], "type": "opinion", "role": "organiser", "delta": -4 },
            { "unless": [ { "type": "arc_mark", "mark": "at_hall" } ], "type": "opinion", "role": "organiser", "delta": -12, "memory": "ignored_me" } ] } },
      ],
    },
  ],

  // The arc's decisions: never spotlit on their own (`arc_only`); the run asks
  // for them, and the director presents them with the run's cast.
  "dilemmas": [
    {
      "id": "dilemma.flood_money", "category": "significant", "arc_only": true,
      "title_key": "dilemma-flood-money", "situation_key": "dilemma-flood-money-situation",
      "roles": [
        { "id": "organiser", "cast": { "type": "occupation", "occupations": ["occupation.organiser", "occupation.clergy", "occupation.nurse", "occupation.shopkeeper", "occupation.teacher"] } },
        { "id": "hood", "cast": { "type": "ward_neighborhood" } },
      ],
      "deadline_days": 14, "cooldown_days": 0, "scene": "scene.flood_hall",
      "options": [
        { "id": "now", "label_key": "dilemma-flood-money-now", "aftermath_key": "dilemma-flood-money-now-after",
          "effects": [
            { "type": "opinion", "role": "organiser", "delta": 8 },
            { "type": "approval", "neighborhood": "hood", "delta": 0.02 },
            { "type": "standing", "delta": -3 } ] },
        { "id": "worst", "label_key": "dilemma-flood-money-worst", "aftermath_key": "dilemma-flood-money-worst-after",
          "effects": [
            { "type": "opinion", "role": "organiser", "delta": 3 },
            { "type": "approval", "neighborhood": "hood", "delta": 0.01 },
            { "type": "standing", "delta": -1 } ] },
        { "id": "wait", "default": true, "label_key": "dilemma-flood-money-wait", "aftermath_key": "dilemma-flood-money-wait-after",
          "effects": [
            { "type": "opinion", "role": "organiser", "delta": -6 },
            { "type": "approval", "neighborhood": "hood", "delta": -0.01 },
            { "type": "standing", "delta": 1 } ] },
      ],
    },
  ],

  // The arc's ask: offered only by a run, from its organiser.
  "asks": [
    { "id": "ask.flood_shelter", "name_key": "ask-flood-shelter", "from": ["arc"],
      "asker": { "type": "occupation", "occupations": ["occupation.organiser", "occupation.clergy", "occupation.nurse", "occupation.shopkeeper", "occupation.teacher"] },
      "roles": [ { "id": "official", "cast": { "type": "office" } } ],
      "needs": [
        { "type": "talk", "role": "official",
          "choice": { "label_key": "ask-choice-flood-shelter", "say_key": "ask-say-flood-shelter",
            "replies": [
              { "key": "talk-ask-flood-shelter-yes", "when": [ { "type": "opinion", "slot": "speaker", "min": -20 } ] },
              { "key": "talk-ask-flood-shelter-no", "agrees": false } ] } } ],
      "deadline_days": [10, 14], "cooldown_days": 0, "big": true,
      "keep": [
        { "type": "opinion", "role": "asker", "delta": 10, "memory": "kept_promise" },
        { "type": "approval", "neighborhood": "asker_hood", "delta": 0.01 } ],
      "break": [ { "type": "opinion", "role": "asker", "delta": -10, "memory": "broke_promise" } ],
      "decline": [ { "type": "opinion", "role": "asker", "delta": -4 } ],
      "detail_key": "ask-flood-shelter-detail", "need_key": "ask-flood-shelter-need",
      "kept_key": "ask-flood-shelter-kept", "broken_key": "ask-flood-shelter-broken" },
  ],

  "scenes": [
    { "id": "scene.flood_hall", "place": { "type": "kind", "kind": "streets" },
      "beats": [ { "speaker": "organiser", "line": "scene-flood-hall-organiser" } ] },
  ],

  // Heard in the struck neighbourhood while the stages last.
  "overheard": [
    { "id": "overheard.flood.skips", "key": "heard-flood-skips", "weight": 1.5,
      "when": [ { "type": "arc", "arc": "arc.flood", "stages": ["struck", "counting"], "here": "hood" } ] },
  ],
}
