// The rival (DEC-109; DEC-032's rival storyline, folded into an arc): the
// standing arc of a campaign. Once the player is standing, whoever stands
// against them circles, makes an offer, issues a challenge, and meets them
// in a debate before the vote; the voters end it.
//
// A standing arc (`standing: "campaign"`): it runs beside the cap on arcs
// and leads a campaign chapter when no material arc does. A campaign's
// climax is the election itself.
//
// The turn is played (DEC-112; docs/design/EXCHANGE_SCENES.md §2.3, §10.1):
// the showdown is a debate at a hall, an exchange of three rounds before the
// neighbourhoods of the seat the player is standing for. Turning up is
// accepting the challenge; staying away is declining it, and an empty chair
// is its cost. Nothing asks the player yes or no (`dilemma.debate_challenge`
// is retired), and a time skip cannot answer for them.
//
// Preparation is ordinary play in the stage before (`lead_up`): walk the
// area least pleased with the player with someone who lives there (its
// worries: the `heard` line there), read the rival's cuttings (their faults:
// `turn` lines, and exact previews of their answers), rehearse with an ally
// (round 1 is not cold), ask someone with a name to speak (the `second`
// line). None is the price of entry: the record, owning it and the safe line
// can still carry a room. A player who reaches the showdown without the
// weeks before (a short campaign) may still rehearse, ask and read there.
//
// Transitions read; beats write. The edges read the campaign (is the player
// still standing, how near is the vote), the result of the race once it is
// decided (`last_race`), and the run's marks. Marks: `pact` (the truce was
// taken), `refused` (the offer was turned down), `read` (the cuttings);
// from the debate `debate_won`, `debate_split`, `debate_lost`,
// `debate_ducked` (its four ends) and what a line leaves (`promised`,
// `aired`, `owned`, `tabled`); and what preparing for it gave (`rehearsed`,
// `endorsed`). The voters still end it: the debate moves approval and
// recognition a week or two before the vote, and the vote reads them.
//
// Stage ids are the storyline's (`shadow`, `offer`, `pact`, `showdown`), so
// a save from before the fold loads at the same stage; `lead_up` is new.
{
  "kind": "arcs",
  "items": [
    {
      "id": "arc.rival", "title_key": "arc-rival", "themes": ["scheme"], "standing": "campaign",
      // A town's rival until rivals are kept for a region.
      "tiers": ["local"], "cooldown_days": 60,
      "raise": [ { "type": "campaigning" } ],
      "roles": [
        { "id": "rival", "cast": { "type": "rival" } },
        // Where the debate is held, who chairs it, who might speak for the
        // player, who might rehearse them, where the cuttings are kept, and
        // the area least pleased with them, to walk before the night.
        { "id": "hall", "cast": { "type": "place", "kinds": ["community_centre", "school", "town_hall"] } },
        { "id": "chair", "optional": true,
          "cast": { "type": "occupation", "occupations": ["occupation.editor", "occupation.journalist"] } },
        { "id": "backer", "optional": true,
          "cast": { "type": "occupation", "occupations": ["occupation.union_steward", "occupation.business_leader",
            "occupation.clergy", "occupation.head_teacher", "occupation.gp"] } },
        { "id": "ally", "optional": true,
          "cast": { "type": "occupation", "occupations": ["occupation.party_chair", "occupation.organiser",
            "occupation.teacher", "occupation.shopkeeper", "occupation.retiree"] } },
        { "id": "paper", "optional": true, "cast": { "type": "place", "kinds": ["news_office"] } },
        { "id": "ward", "optional": true, "cast": { "type": "area", "pick": "least_pleased" } },
      ],
      "heat": { "start": 0.3 },
      "stages": [
        // The campaign opens, and the rival turns up wherever the player goes.
        { "id": "shadow", "key": "arc-rival-shadow", "rise": 0.03,
          "beats": [
            { "id": "statement", "type": "press", "headline_key": "headline-arc-rival-statement" },
            // Who is with them? An ally who will say teaches the rival to
            // `known`: one of several ways to know them.
            { "id": "who", "type": "talk", "with": "ally",
              "effects": [ { "type": "learn", "role": "rival", "level": "known" } ],
              "choice": { "label_key": "talk-arc-rival-who", "say_key": "talk-arc-rival-who-say",
                "replies": [
                  { "key": "talk-arc-rival-who-yes", "agrees": true,
                    "when": [ { "type": "opinion", "slot": "speaker", "min": 0 } ] },
                  { "key": "talk-arc-rival-who-no" } ] } },
          ],
          "next": [
            { "to": "won", "when": [ { "type": "last_race", "won": true } ] },
            { "to": "lost", "when": [ { "type": "last_race", "won": false } ] },
            { "to": "cooled", "when": [ { "type": "campaigning", "is": false } ] },
            { "to": "offer", "after_days": 5 } ] },

        // An offer: a truce, or a fight.
        { "id": "offer", "key": "arc-rival-offer", "rise": 0.03,
          "beats": [
            { "id": "terms", "type": "decision", "dilemma": "dilemma.rival_offer", "weight": "significant",
              "on": {
                "truce": { "sets": "pact", "heat": -0.15 },
                "refuse": { "sets": "refused", "heat": 0.1 },
                "ignore": { "heat": 0.05 } } },
          ],
          "next": [
            { "to": "won", "when": [ { "type": "last_race", "won": true } ] },
            { "to": "lost", "when": [ { "type": "last_race", "won": false } ] },
            { "to": "cooled", "when": [ { "type": "campaigning", "is": false } ] },
            { "to": "pact", "when": [ { "type": "arc_mark", "mark": "pact" } ] },
            { "to": "lead_up", "when": [ { "type": "election_within", "days": 40 } ] },
            { "to": "cooled", "after_days": 120 } ] },

        // The truce holds until the vote is close.
        { "id": "pact", "key": "arc-rival-pact",
          "next": [
            { "to": "won", "when": [ { "type": "last_race", "won": true } ] },
            { "to": "lost", "when": [ { "type": "last_race", "won": false } ] },
            { "to": "cooled", "when": [ { "type": "campaigning", "is": false } ] },
            { "to": "lead_up", "when": [ { "type": "election_within", "days": 40 } ] },
            { "to": "cooled", "after_days": 120 } ] },

        // The challenge is out, and there are weeks to get ready for it.
        { "id": "lead_up", "key": "arc-rival-lead-up", "rise": 0.03,
          "beats": [
            { "id": "challenge", "type": "press", "headline_key": "headline-arc-rival-challenge" },
            { "id": "dare", "type": "move", "actor": "rival", "weight": 0.4, "line_key": "skip-item-arc-rival-dare",
              "when": [ { "type": "arc_days", "min": 7 } ],
              "effects": [ { "type": "heat", "delta": 0.05 } ] },
            // Walk the area least pleased with the player, with someone who
            // lives there: its worries, so the `heard` line there.
            { "id": "walk", "type": "visit", "at": "ward", "time": "half",
              "verb_key": "visit-arc-rival-walk", "outcome_key": "outcome-arc-rival-walk",
              "effects": [ { "type": "learn", "role": "ward", "level": "known" } ] },
            // Read the rival's cuttings at the paper.
            { "id": "cuttings", "type": "visit", "at": "paper", "time": "half", "sets": "read",
              "verb_key": "visit-arc-rival-cuttings", "outcome_key": "outcome-arc-rival-cuttings",
              "effects": [ { "type": "learn", "role": "rival", "level": "detailed" } ] },
            // Rehearse with an ally: round 1 is not cold, and they brief
            // the player on the rival.
            { "id": "rehearse", "type": "talk", "with": "ally", "sets": "rehearsed",
              "effects": [ { "type": "learn", "role": "rival", "level": "known" } ],
              "choice": { "label_key": "talk-arc-rival-rehearse", "say_key": "talk-arc-rival-rehearse-say",
                "replies": [
                  { "key": "talk-arc-rival-rehearse-yes", "agrees": true,
                    "when": [ { "type": "any", "of": [
                      { "type": "opinion", "slot": "speaker", "min": 0 },
                      { "type": "favour", "slot": "speaker", "owed_to_player": true } ] } ] },
                  { "key": "talk-arc-rival-rehearse-no" } ] } },
            // Ask someone with a name to speak for the player. A friend says
            // yes; someone who is not yet one says yes for a favour later.
            { "id": "backer", "type": "talk", "with": "backer", "sets": "endorsed",
              "choice": { "label_key": "talk-arc-rival-backer", "say_key": "talk-arc-rival-backer-say",
                "replies": [
                  { "key": "talk-arc-rival-backer-yes", "agrees": true,
                    "when": [ { "type": "any", "of": [
                      { "type": "opinion", "slot": "speaker", "min": 10 },
                      { "type": "favour", "slot": "speaker", "owed_to_player": true } ] } ] },
                  { "key": "talk-arc-rival-backer-owe", "agrees": true,
                    "when": [ { "type": "opinion", "slot": "speaker", "min": -10 } ],
                    "effects": [ { "type": "favour", "role": "backer" } ] },
                  { "key": "talk-arc-rival-backer-no" } ] } },
          ],
          "next": [
            { "to": "won", "when": [ { "type": "last_race", "won": true } ] },
            { "to": "lost", "when": [ { "type": "last_race", "won": false } ] },
            { "to": "cooled", "when": [ { "type": "campaigning", "is": false } ] },
            { "to": "showdown", "when": [ { "type": "election_within", "days": 30 } ] },
            { "to": "cooled", "after_days": 120 } ] },

        // The turn: a debate in front of the seat, with the vote a month off.
        // The clock is the debate's day, two or three weeks on, so the vote
        // reads it. (EXCHANGE_SCENES §10.1 has the lead-up from 45 days and
        // the showdown from 21; in an eight-week campaign that left the
        // truce under a week and the debate days from the vote, so the
        // lead-up runs from 40 days and the showdown keeps X1's month.) What
        // was not done in the weeks before can still be done until then.
        { "id": "showdown", "key": "arc-rival-showdown", "climax": true, "rise": 0.05,
          "clock": { "days": [14, 21] },
          "beats": [
            { "id": "rehearse", "type": "talk", "with": "ally", "sets": "rehearsed",
              "when": [ { "type": "arc_mark", "mark": "rehearsed", "is": false } ],
              "effects": [ { "type": "learn", "role": "rival", "level": "known" } ],
              "choice": { "label_key": "talk-arc-rival-rehearse", "say_key": "talk-arc-rival-rehearse-say",
                "replies": [
                  { "key": "talk-arc-rival-rehearse-yes", "agrees": true,
                    "when": [ { "type": "any", "of": [
                      { "type": "opinion", "slot": "speaker", "min": 0 },
                      { "type": "favour", "slot": "speaker", "owed_to_player": true } ] } ] },
                  { "key": "talk-arc-rival-rehearse-no" } ] } },
            { "id": "backer", "type": "talk", "with": "backer", "sets": "endorsed",
              "when": [ { "type": "arc_mark", "mark": "endorsed", "is": false } ],
              "choice": { "label_key": "talk-arc-rival-backer", "say_key": "talk-arc-rival-backer-say",
                "replies": [
                  { "key": "talk-arc-rival-backer-yes", "agrees": true,
                    "when": [ { "type": "any", "of": [
                      { "type": "opinion", "slot": "speaker", "min": 10 },
                      { "type": "favour", "slot": "speaker", "owed_to_player": true } ] } ] },
                  { "key": "talk-arc-rival-backer-owe", "agrees": true,
                    "when": [ { "type": "opinion", "slot": "speaker", "min": -10 } ],
                    "effects": [ { "type": "favour", "role": "backer" } ] },
                  { "key": "talk-arc-rival-backer-no" } ] } },
            { "id": "cuttings", "type": "visit", "at": "paper", "time": "half", "sets": "read",
              "when": [ { "type": "arc_mark", "mark": "read", "is": false } ],
              "verb_key": "visit-arc-rival-cuttings", "outcome_key": "outcome-arc-rival-cuttings",
              "effects": [ { "type": "learn", "role": "rival", "level": "detailed" } ] },
            // The debate (EXCHANGE_SCENES §2.3).
            { "id": "debate", "type": "exchange", "once": true,
              "at": "hall",
              "time": "slot",
              "sides": { "other": "rival", "chair": "chair", "second": "backer" },
              "layout": "crowd",
              "audience": [
                // The areas one level down of the seat the player is standing for.
                { "from": "areas", "of": "race", "max": 5, "weight": "voters", "start": "approval" } ],
              "rounds": 3,
              "prompts": [
                // Each round: the sources the other side may use, best
                // first. The first that gives an attack they hold is used;
                // `top_worry` always gives one, so a clean record is asked
                // a question and never charged with something invented.
                { "round": 1, "by": "other", "from": ["broken_promise", "vote_against_lean", "failed_law", "thin_record", "top_worry"] },
                { "round": 2, "by": "other", "from": ["scandal", "hidden_fact", "absent", "vote_against_lean", "governing_record", "top_worry"] },
                { "round": 3, "by": "chair", "from": ["top_worry"] } ],
              "moves": ["record", "heard", "turn", "promise", "act", "own", "second", "pass"],
              "prep": [
                { "mark": "rehearsed", "removes": "cold" },
                { "mark": "endorsed", "adds": "second" },
                // A truce taken earlier: the rival keeps off the personal.
                { "mark": "pact", "bars": ["hidden_fact", "scandal"] } ],
              "outcome": {
                "won": { "sets": "debate_won", "heat": -0.10 },
                "split": { "sets": "debate_split" },
                "lost": { "sets": "debate_lost", "heat": 0.10 },
                // Its day passed and the player never came.
                "absent": { "sets": "debate_ducked", "heat": 0.05 } },
              "text": "exchange-debate" },
          ],
          "next": [
            { "to": "won", "when": [ { "type": "last_race", "won": true } ] },
            { "to": "lost", "when": [ { "type": "last_race", "won": false } ] },
            { "to": "cooled", "when": [ { "type": "campaigning", "is": false } ] },
            { "to": "cooled", "after_days": 90 } ] },

        // The voters chose the player. What the rival makes of it depends on
        // how the campaign was fought.
        { "id": "won", "key": "arc-rival-won",
          "exit": { "effects": [
            { "when": [ { "type": "arc_mark", "mark": "pact" } ], "type": "opinion", "role": "rival", "delta": 4 },
            { "unless": [ { "type": "arc_mark", "mark": "pact" } ], "type": "opinion", "role": "rival", "delta": -6 },
            // The debate is on the record of a campaign won: more for a
            // win there, something for holding their own, less for an
            // empty chair.
            { "when": [ { "type": "arc_mark", "mark": "debate_won" } ], "type": "record", "delta": 0.02 },
            { "when": [ { "type": "arc_mark", "mark": "debate_split" } ], "type": "record", "delta": 0.01 },
            { "when": [ { "type": "arc_mark", "mark": "debate_ducked" } ], "type": "record", "delta": -0.01 },
            // A secret aired in the hall leaves an enemy.
            { "when": [ { "type": "arc_mark", "mark": "aired" } ], "type": "opinion", "role": "rival", "delta": -6, "memory": "pressed_me" },
            { "when": [ { "type": "arc_mark", "mark": "refused" } ], "type": "standing", "delta": 1 } ] } },
        // The voters chose someone else.
        { "id": "lost", "key": "arc-rival-lost",
          "exit": { "effects": [
            { "type": "opinion", "role": "rival", "delta": 5 },
            { "when": [ { "type": "arc_mark", "mark": "pact" } ], "type": "standing", "delta": -2 },
            // A debate won softens the fall; one lost, or ducked, does not.
            { "when": [ { "type": "arc_mark", "mark": "debate_won" } ], "type": "standing", "delta": 1 },
            { "when": [ { "type": "arc_mark", "mark": "debate_lost" } ], "type": "opinion", "role": "rival", "delta": 2 },
            { "when": [ { "type": "arc_mark", "mark": "debate_ducked" } ], "type": "record", "delta": -0.01 } ] } },
        // The campaign went on past the rivalry (a race called off, a rival
        // who withdrew).
        { "id": "cooled", "key": "arc-rival-cooled",
          "exit": { "effects": [ { "type": "opinion", "role": "rival", "delta": 3 } ] } },
      ],
    },
  ],
}
