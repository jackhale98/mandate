    // --- Small talk -------------------------------------------------------------------
    // Everyone has something to say about their own life; the cool don't.
    { "id": "line.small.concern", "part": "substance", "topic": "topic.small_talk",
      "key": "talk-small-concern",
      "when": [ { "type": "concern", "of": "speaker", "concerns": ["concern.jobs", "concern.housing", "concern.environment", "concern.taxes", "concern.services", "concern.recovery"] },
                { "type": "opinion", "slot": "speaker", "min": 15 } ] },
    { "id": "line.small.weather", "part": "substance", "topic": "topic.small_talk",
      "key": "talk-small-weather", "fallback": true },
    { "id": "line.small.family", "part": "substance", "topic": "topic.small_talk",
      "key": "talk-small-family", "fallback": true },
    { "id": "line.small.warm", "part": "substance", "topic": "topic.small_talk",
      "key": "talk-small-warm",
      "when": [ { "type": "opinion", "slot": "speaker", "min": 50 } ] },
    { "id": "line.small.trusted", "part": "substance", "topic": "topic.small_talk",
      "key": "talk-small-trusted",
      "when": [ { "type": "opinion", "slot": "speaker", "min": 50 },
                { "type": "trust", "slot": "speaker", "min": 0.5 } ] },
