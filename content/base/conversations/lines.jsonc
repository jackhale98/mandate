      "key": "talk-about-place-any",
      "when": [ { "type": "about", "kinds": ["place"], "workplace": false },
                { "type": "opinion", "slot": "speaker", "min": -15 } ] },
    // The rival: colleagues know the plans; everyone else knows the person.
    { "id": "line.about.rival", "part": "substance", "topic": "topic.about",
      "key": "talk-about-rival",
      "when": [ { "type": "is_rival", "slot": "about" },
                { "type": "tells", "subject": { "type": "rival_plans" }, "min": "known" } ],
      "teaches": [ { "subject": { "type": "rival_plans" }, "level": "known" } ] },
    { "id": "line.about.rival_close", "part": "substance", "topic": "topic.about", "weight": 2,
      "key": "talk-about-rival-close",
      "when": [ { "type": "is_rival", "slot": "about" },
                { "type": "tells", "subject": { "type": "rival_plans" }, "min": "known" },
                { "type": "opinion", "slot": "speaker", "min": 50 },
                { "type": "trust", "slot": "speaker", "min": 0.5 } ],
      "teaches": [ { "subject": { "type": "rival_plans" }, "level": "known" } ] },
    { "id": "line.about.rival_name", "part": "substance", "topic": "topic.about",
      "key": "talk-about-rival-name",
      "when": [ { "type": "is_rival", "slot": "about" },
                { "type": "tells", "subject": { "type": "person", "slot": "about" }, "min": "heard" },
                { "type": "opinion", "slot": "speaker", "max": 15 } ],
      "teaches": [ { "subject": { "type": "person", "slot": "about" }, "level": "heard" } ] },
    { "id": "line.about.rival_local", "part": "substance", "topic": "topic.about",
      "key": "talk-about-rival-local",
      "when": [ { "type": "is_rival", "slot": "about" },
                { "type": "occupation", "slot": "speaker", "occupations": [
                  "occupation.union_steward", "occupation.business_leader", "occupation.party_chair",
                  "occupation.plant_manager", "occupation.farmer", "occupation.journalist", "occupation.editor", "occupation.shopkeeper",
                  "occupation.diner_owner", "occupation.organiser", "occupation.clergy", "occupation.teacher",
                  "occupation.nurse", "occupation.resident", "occupation.retiree" ] },
                { "type": "tells", "subject": { "type": "person", "slot": "about" }, "min": "known" } ],
      "teaches": [ { "subject": { "type": "person", "slot": "about" }, "level": "known" } ] },
    { "id": "line.about.rival_bold", "part": "substance", "topic": "topic.about", "weight": 2,
      "key": "talk-about-rival-bold",
      "when": [ { "type": "is_rival", "slot": "about" },
                { "type": "personality", "slot": "about", "axis": "boldness", "min": 0.65 },
                { "type": "occupation", "slot": "speaker", "occupations": [
                  "occupation.union_steward", "occupation.business_leader", "occupation.party_chair",
                  "occupation.plant_manager", "occupation.farmer", "occupation.journalist", "occupation.editor", "occupation.shopkeeper",
                  "occupation.diner_owner", "occupation.organiser", "occupation.clergy", "occupation.teacher",
                  "occupation.nurse", "occupation.resident", "occupation.retiree" ] },
                { "type": "tells", "subject": { "type": "person", "slot": "about" }, "min": "known" } ],
      "teaches": [ { "subject": { "type": "person", "slot": "about" }, "level": "known" } ] },
    // A bill or a policy: who is for it (politicians count heads).
    { "id": "line.about.bill_heard", "part": "substance", "topic": "topic.about",
      "key": "talk-about-bill-heard",
      "when": [ { "type": "tells", "subject": { "type": "policy_support", "of": "about" }, "min": "heard" },
                { "type": "opinion", "slot": "speaker", "max": 15 } ] },
    { "id": "line.about.bill", "part": "substance", "topic": "topic.about",
      "key": "talk-about-bill",
      "when": [ { "type": "tells", "subject": { "type": "policy_support", "of": "about" }, "min": "known" } ],
      "teaches": [ { "subject": { "type": "policy_support", "of": "about" }, "level": "known" } ] },
