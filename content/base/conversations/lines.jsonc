    { "id": "line.open.trusted", "part": "opener", "key": "talk-open-trusted", "weight": 2,
      "when": [ { "type": "opinion", "slot": "speaker", "min": 50 },
                { "type": "trust", "slot": "speaker", "min": 0.5 } ] },
    { "id": "line.open.trusted.2", "part": "opener", "key": "talk-open-trusted-2", "weight": 2,
