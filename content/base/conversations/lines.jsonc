      "key": "talk-about-bill-2",
      "when": [ { "type": "tells", "subject": { "type": "policy_support", "of": "about" }, "min": "known" },
                { "type": "occupation", "slot": "speaker", "occupations": ["councillor", "mayor"] } ],
      "teaches": [ { "subject": { "type": "policy_support", "of": "about" }, "level": "known" } ] },

    // --- Pitching a policy -------------------------------------------------------------
    // The reply is a first reaction; the outcome (moved or not) follows it.
