      "key": "talk-worries-fb-farm", "fallback": true,
      "when": [ { "type": "occupation", "slot": "speaker", "occupations": ["occupation.farmer"] } ] },
    { "id": "line.worries.fb.press", "part": "substance", "topic": "topic.worries", "weight": 3,
      "key": "talk-worries-fb-press", "fallback": true,
      "when": [ { "type": "occupation", "slot": "speaker", "occupations": ["occupation.journalist", "occupation.editor"] } ] },
    { "id": "line.worries.fb.clergy", "part": "substance", "topic": "topic.worries", "weight": 3,
      "key": "talk-worries-fb-clergy", "fallback": true,
      "when": [ { "type": "occupation", "slot": "speaker", "occupations": ["occupation.clergy"] } ] },
    { "id": "line.worries.fb.care", "part": "substance", "topic": "topic.worries", "weight": 3,
      "key": "talk-worries-fb-care", "fallback": true,
      "when": [ { "type": "occupation", "slot": "speaker", "occupations": ["occupation.teacher", "occupation.nurse"] } ] },
    { "id": "line.worries.fb.folk", "part": "substance", "topic": "topic.worries", "weight": 3,
      "key": "talk-worries-fb-folk", "fallback": true,
      "when": [ { "type": "occupation", "slot": "speaker", "occupations": ["occupation.resident", "occupation.retiree"] } ] },
    // The town's worries: a rumour (neutral), plainly (warm), and the
    // speaker's own street (trusted, or anyone opened up).
    { "id": "line.worries.rumour", "part": "substance", "topic": "topic.worries",
      "key": "talk-worries-rumour",
