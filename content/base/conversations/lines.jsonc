    { "id": "line.small.bus", "part": "substance", "topic": "topic.small_talk",
      "key": "talk-small-bus",
      "when": [ { "type": "opinion", "slot": "speaker", "min": -15 } ] },
    { "id": "line.small.ducks", "part": "substance", "topic": "topic.small_talk",
