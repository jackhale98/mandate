    // --- What people are worried about -------------------------------------------------
    // The safe answers: everyone's, then each role's (cool speakers say these).
    { "id": "line.worries.shrug", "part": "substance", "topic": "topic.worries",
      "key": "talk-worries-shrug", "fallback": true },
    { "id": "line.worries.weather", "part": "substance", "topic": "topic.worries",
