// Conversation voices (DEC-093): a blunt steward and a smooth developer say
// the same fact differently. A speaker's voice is the highest-`priority`
// voice whose conditions all hold (ties: load order); `voice.plain` has no
// conditions. `closer_share`: how often a reply in the voice ends with one
// of its closers (each voice that closes has at least two).
//
// Traits come first (they are rarer and say more), then personality, which
// splits the rest into four regions: bold and cool (blunt), timid (anxious),
// cool and steady (wry), warm (folksy); the middle is plain. Openers in a
// voice repeat the voice's conditions (`lines.jsonc`), so a speaker's
// openers and closers agree; the personality regions are kept apart there.
{
  "kind": "talk_voices",
  "items": [
    // Charmers and schemers: flattering, deniable.
    { "id": "voice.smooth", "priority": 8, "closer_share": 0.7,
      "when": [ { "type": "trait", "slot": "speaker", "traits": ["trait.charmer", "trait.schemer"] } ] },
    // The vain: their own standing in every sentence.
    { "id": "voice.pompous", "priority": 7, "closer_share": 0.6,
      "when": [ { "type": "trait", "slot": "speaker", "traits": ["trait.vain"] } ] },
    // The cautious: hedged, looking over their shoulder.
    { "id": "voice.guarded", "priority": 6, "closer_share": 0.6,
      "when": [ { "type": "trait", "slot": "speaker", "traits": ["trait.cautious"] } ] },
    // Zealots and reformers: they mean every word.
    { "id": "voice.earnest", "priority": 5, "closer_share": 0.5,
      "when": [ { "type": "trait", "slot": "speaker", "traits": ["trait.zealous", "trait.reformer"] } ] },
    // Bold and cool: says it and stops. Rarely bothers with a closer.
    { "id": "voice.blunt", "priority": 4, "closer_share": 0.35,
      "when": [ { "type": "personality", "slot": "speaker", "axis": "boldness", "min": 0.6 },
                { "type": "personality", "slot": "speaker", "axis": "warmth", "max": 0.45 } ] },
    // Timid: apologises, trails off.
    { "id": "voice.anxious", "priority": 3, "closer_share": 0.6,
      "when": [ { "type": "personality", "slot": "speaker", "axis": "boldness", "max": 0.28 } ] },
    // Cool but not bold: dry, amused, unimpressed.
    { "id": "voice.wry", "priority": 2, "closer_share": 0.5,
      "when": [ { "type": "personality", "slot": "speaker", "axis": "warmth", "max": 0.45 } ] },
    // Warm: homely, roundabout, generous with the kettle.
    { "id": "voice.folksy", "priority": 1, "closer_share": 0.55,
      "when": [ { "type": "personality", "slot": "speaker", "axis": "warmth", "min": 0.68 } ] },
    { "id": "voice.plain", "priority": 0, "closer_share": 0.3 },
  ],
}
