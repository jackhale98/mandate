// Parties, elections, polls, and campaigns (DEC-027 to DEC-029, DEC-071).
// Magnitudes follow docs/design/research/SIMULATION_MODELS.md; tune via sweeps.
{
  "kind": "politics",
  "value": {
    "party_count": 3,
    "party_names": {
      // Fictional names only (REQ-001).
      "nouns": ["Party", "Alliance", "Union", "Movement", "League", "Front", "Coalition"],
      "by_attitude": [
        { "attitude": "redistribution", "pro": ["Commonwealth", "Fair Share", "Solidarity"], "anti": ["Enterprise", "Free Hand", "Self-Reliance"] },
        { "attitude": "tax_tolerance", "pro": ["Public Good", "Civic"], "anti": ["Taxpayers'", "Low Tax"] },
        { "attitude": "social_liberalism", "pro": ["Open Society", "Liberty"], "anti": ["Family", "Decency"] },
        { "attitude": "environment", "pro": ["Green Valley", "Evergreen"], "anti": ["Growth", "Industry"] },
        { "attitude": "law_and_order", "pro": ["Order", "Safe Streets"], "anti": ["Civil Rights", "Due Process"] },
        { "attitude": "localism", "pro": ["Hometown", "Localist"], "anti": ["National", "United"] },
        { "attitude": "tradition", "pro": ["Heritage", "Hearth"], "anti": ["Forward", "New Dawn"] },
        { "attitude": "reform_appetite", "pro": ["Reform", "Renewal"], "anti": ["Steady Hand", "Continuity"] },
      ],
    },
    // The party line (DEC-027): one rule for the player's whip and NPC members.
    // score = platform × fit(bill, party platform) + sponsor term; a score
    // inside ±free_band is a free vote. npc_pull scales an NPC member's lean.
    "party_line": {
      "platform": 1.0,
      "own_sponsor": 0.5,
      "governing_sponsor": 0.2,
      "other_sponsor": -0.2,
      "free_band": 0.25,
      "npc_pull": 0.6,
    },
    "vote": {
      "issue_weight": 3.0,
      "beta_low": 0.15,
      "beta_high": 0.6,
      "polarization_low": 0.2,
      "polarization_high": 0.45,
      "party_weight": 1.4,
      "valence_weight": 1.0,
      "retrospective_weight": 5.0,     // the record: utility per unit of (approval − the nation's + economy), × executive × media
      "executive_multiplier": 1.8,
      "home_ward_bonus": 0.25,
      "partisan_discount": 0.4,
      "incumbent_awareness": 0.45,
      "challenger_awareness": 0.12,
      "race_shock_sd": 0.12,
      "national_swing_sd": 0.15,
      "strategic_weight": 1.6,
      "minor_party_threshold": 0.16,
      "record_penalty": 5.0,
      "record_bonus": 0.0,
      "record_baseline": 0.35,
      "renomination_standing": 25.0,
      "salience_base": 1.5,             // issue salience: base + concern levels, scaled to mean 1 (DEC-078)
      // Perceived position on a partisan ballot: own views and party platform.
      "perceived_own_weight": 0.6,
      "perceived_party_weight": 0.4,
      // Valence: oratory and integrity, each around its midpoint.
      "valence_oratory": 0.5,
      "valence_integrity": 0.5,
      "governing_party_record": 0.4,   // the governing party's new nominee carries this share of the record
      "retro_economy_weight": 2.0,     // the benchmarked economy beside approval of the government
      "retro_unemployment_scale": 10.0, // per point of unemployment change beyond the national change
      "retro_level_weight": 0.5,       // the rate now above the nation's, beside the year's change
      "media_base": 0.5,               // media attention: base + share of the region's people
      "media_town_share": 0.5,
      "player_approval_weight": 2.5,
      "independent_viability": 0.3,
      // Starting awareness (shares of incumbent_awareness), home bonus, cap.
      "player_incumbent_awareness": 0.8,
      "officeholder_awareness": 0.6,
      "home_awareness_bonus": 0.15,
      "awareness_cap": 0.95,
      // Being known is what counts: awareness beyond `awareness_known` is
      // worth `awareness_beyond` of a point each.
      "awareness_known": 1.0,
      "awareness_beyond": 1.0,
    },
    "turnout": {
      "standalone": 0.55,
      "concurrent": 0.95,
      "habit": 0.3,
      "mobilisation_max": 0.08,
      // A cohort's habit: the neighbourhood's turnout × (base + propensity × its own).
      "habit_base": 0.6,
      "habit_propensity": 0.8,
    },
    "polls": {
      "pollsters": ["Civic Pulse", "Northgate Research", "Ledger & Co."],
      "sample_size": 600,
      "house_sd": 0.012,
      "shared_sd": 0.02,
      "early_multiplier": 2.0,
      "every_days": 14,
    },
    "campaign": {
      "persuasion_half_life_days": 60,
      "awareness_per_canvass": 0.18,
      "persuasion_per_canvass": 0.03,
      "mobilisation_per_canvass": 0.25,
      "diminishing": 0.6,
      "ad_cost": 1500,
      "awareness_per_ad": 0.12,
      "npc_contacts_per_week": 1.5,
      "npc_effort_base": 0.5,          // abstracted effort × (base + oratory)
      "contact_memory": 0.8,           // share of recent contacts remembered each week
      "ad_saturation": 0.7,            // each further ad in a turn is worth this much of the last
      "ad_persuasion_share": 0.05,     // an ad persuades this share of a canvass contact (M5d part 2: 0.25 → 0.05, BALANCE_LOG)
    },
    "ai": {
      // Utility AI (DEC-030, DEC-071 §8). Score = weight × profile × Π curve(input).
      "top_n": 3,
      "actions": [
        { "action": "canvass", "weight": 1.0, "considerations": [
          { "input": "campaigning", "curve": { "type": "step", "x": 0.5, "lo": 0.0, "hi": 1.0 } },
          { "input": "unknown", "curve": { "type": "linear", "m": 0.8, "b": 0.3 } },
          { "input": "race_closeness", "curve": { "type": "logistic", "k": 6.0, "x0": 0.35 } },
        ] },
        { "action": "town_hall", "weight": 0.9, "considerations": [
          { "input": "campaigning", "curve": { "type": "step", "x": 0.5, "lo": 0.0, "hi": 1.0 } },
          { "input": "unknown", "curve": { "type": "linear", "m": 0.6, "b": 0.4 } },
          { "input": "race_closeness", "curve": { "type": "logistic", "k": 6.0, "x0": 0.4 } },
        ] },
        { "action": "advertise", "weight": 0.9, "considerations": [
          { "input": "campaigning", "curve": { "type": "step", "x": 0.5, "lo": 0.0, "hi": 1.0 } },
          { "input": "funds", "curve": { "type": "logistic", "k": 10.0, "x0": 0.3 } },
          { "input": "election_near", "curve": { "type": "linear", "m": 0.7, "b": 0.3 } },
          { "input": "race_closeness", "curve": { "type": "logistic", "k": 6.0, "x0": 0.4 } },
        ] },
        { "action": "fundraise", "weight": 0.6, "considerations": [
          { "input": "funds", "curve": { "type": "linear", "m": -0.9, "b": 1.0 } },
          { "input": "election_near", "curve": { "type": "linear", "m": -0.6, "b": 1.0 } },
        ] },
        { "action": "lobby", "weight": 1.1, "considerations": [
          { "input": "bill_stake", "curve": { "type": "logistic", "k": 8.0, "x0": 0.3 } },
          { "input": "bill_closeness", "curve": { "type": "logistic", "k": 8.0, "x0": 0.45 } },
        ] },
        { "action": "propose_bill", "weight": 0.35, "considerations": [
          { "input": "agenda", "curve": { "type": "logistic", "k": 12.0, "x0": 0.75 } },
          { "input": "no_own_bill", "curve": { "type": "step", "x": 0.5, "lo": 0.0, "hi": 1.0 } },
          { "input": "council_free", "curve": { "type": "linear", "m": 1.0, "b": 0.0 } },
          { "input": "campaigning", "curve": { "type": "step", "x": 0.5, "lo": 1.0, "hi": 0.2 } },
        ] },
        { "action": "rest", "weight": 0.12, "considerations": [
          { "input": "constant", "curve": { "type": "linear", "m": 0.0, "b": 1.0 } },
        ] },
      ],
      "profiles": [
        { "id": "ideologue", "mults": [ { "action": "propose_bill", "mult": 1.5 }, { "action": "lobby", "mult": 1.3 }, { "action": "advertise", "mult": 0.7 } ] },
        { "id": "pragmatist", "mults": [ { "action": "lobby", "mult": 1.1 }, { "action": "fundraise", "mult": 1.2 } ] },
        { "id": "populist", "mults": [ { "action": "town_hall", "mult": 1.5 }, { "action": "canvass", "mult": 1.2 }, { "action": "propose_bill", "mult": 1.1 } ] },
      ],
    },
    "party_id": {
      "attached_by_age": [0.45, 0.55, 0.65, 0.72],
      "stayer_share": 0.6,
      "mover_rate": 0.08,
      "sharpness": 4.0,
      "governing_credit": 0.6,         // attachment to the town hall's party × (1 + (approval − 0.5) × this)
    },
  },
}
