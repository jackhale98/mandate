// Place kinds (DEC-078 decision 6, DEC-079): what the player can do and learn
// at each kind of place. Worldgen decides which places a town has; this
// registry supplies their behaviour. Moving within the town is free; only
// actions cost time.
//
// `actions` are action keys (the action-cost keys in tuning.jsonc, plus the
// free `vote`, `draft`, `file`, and `withdraw`). `late_night` lists the
// actions that may also be taken here in the late-night slot. `services` are
// information services: precise data the pocket only shows in coarse form.
// `fallback` names the kind that hosts this kind's offerings in a town (or,
// for neighbourhood actions, a neighbourhood) without one. Shady actions
// (`take_bribe`, `dip_funds`, `leak_file`) take their payoff and hidden fact
// from media.jsonc.
//
// `layout` (DEC-090 D4, TOWN_GENERATION.md §6.3) is how town layout v2 draws
// the kind: presentation data the engine validates and sends to the client
// (`LayoutContentView`) but never reads. slot: civic | square | works |
// community | commercial | green | harbour. footprint: [[min w, min h],
// [max w, max h]], tiles; the generator tries the largest first. place:
// placement predicates in order of preference (on_square, near_square,
// central, arterial, edge, toward:minerals, toward:woods, near_place:<kind>,
// by_water, shore, riverbank, near_rail, high_ground, largest_residential,
// quiet). signature: the landmark silhouette prop; with: companion features
// the plan reserves (spoil_heap, rail_spur, winding_house, stalls, pier,
// cranes, chimney, flag, park). The pseudo-locations have no layout block;
// every other kind needs one (a kind without is drawn with a generic
// footprint, and validation warns).
//
// `interior` (DEC-088) names the room the player walks into from the street
// (`interiors.jsonc`): presentation data, like `layout`. A kind without one
// keeps the place panel; the Places tab and the town map always open it.
//
// `verbs` are the visit action's verbs offered here (actions.jsonc
// `visit.verbs`, places with purpose): adding one is content, not code.
{
  "kind": "places",
  "items": [
    // Pseudo-locations: always present.
    { "id": "place.home", "key": "home", "name_key": "place-home", "actions": ["rest"] },
    { "id": "place.streets", "key": "streets", "name_key": "place-streets", "actions": ["canvass"] },

    // Civic places.
    {
      "id": "place.council_chamber", "key": "council_chamber", "name_key": "place-council_chamber",
      "actions": ["vote", "introduce", "amend", "withdraw", "lobby", "trade_favor"],
      "services": ["whip_exact"],
      "layout": { "slot": "square", "footprint": [[6, 4], [7, 5]], "place": ["on_square", "near_square"], "signature": "dome", "with": ["flag"], "landmark": true, "art": { "kit": "kit.chamber", "family": "civic" } },
      "interior": "interior.council_chamber",
    },
    {
      // The clerk's office, the mayor's office, and the statistics desk.
      "id": "place.town_hall", "key": "town_hall", "name_key": "place-town_hall",
      "actions": ["draft", "file", "withdraw"],
      "services": ["town_data_detailed", "budget_papers"],
      "layout": { "slot": "square", "footprint": [[7, 4], [9, 5]], "place": ["on_square"], "signature": "clock_tower", "with": ["flag"], "landmark": true, "art": { "kit": "kit.town_hall", "family": "civic" } },
      "interior": "interior.town_hall",
    },
    {
      // Public meetings; a neighbourhood without one meets on its streets.
      "id": "place.community_centre", "key": "community_centre", "name_key": "place-community_centre",
      "actions": ["town_hall"],
      "fallback": "streets",
      "layout": { "slot": "community", "footprint": [[5, 3], [6, 4]], "place": ["largest_residential", "central"], "landmark": false, "art": { "kit": "kit.hall", "family": "civic" } },
    },
    {
      // Small towns without a paper: the press room at the town hall.
      "id": "place.news_office", "key": "news_office", "name_key": "place-news_office",
      "actions": ["press", "advertise", "leak_file"],
      "services": ["newspaper"],
      "fallback": "town_hall",
      "layout": { "slot": "commercial", "footprint": [[4, 3], [4, 4]], "place": ["near_square", "central"], "landmark": false, "art": { "kit": "kit.office", "family": "commercial" } },
    },
    {
      "id": "place.party_office", "key": "party_office", "name_key": "place-party_office",
      "actions": ["fundraise", "dip_funds"],
      "late_night": ["fundraise"],
      "services": ["internal_polls"],
      "fallback": "town_hall",
      "layout": { "slot": "commercial", "footprint": [[3, 3], [4, 3]], "place": ["near_square", "central"], "landmark": false, "art": { "kit": "kit.office", "family": "commercial" } },
    },

    // Where people talk: private meetings and overheard concerns.
    {
      "id": "place.diner", "key": "diner", "name_key": "place-diner",
      // `take_bribe` happens only late at night (an envelope under the table).
      "actions": ["lobby", "trade_favor", "take_bribe"],
      "late_night": ["lobby", "trade_favor", "take_bribe"],
      "services": ["overheard"],
      "layout": { "slot": "commercial", "footprint": [[3, 3], [4, 3]], "place": ["central", "arterial"], "landmark": false, "art": { "kit": "kit.diner", "family": "commercial" } },
      "interior": "interior.diner",
    },
    {
      "id": "place.market", "key": "market", "name_key": "place-market",
      "actions": ["lobby", "trade_favor"],
      "services": ["overheard"],
      "layout": { "slot": "square", "footprint": [[4, 3], [6, 3]], "place": ["on_square", "near_square"], "signature": "stalls", "with": ["stalls"], "landmark": false, "art": { "kit": "kit.market", "family": "commercial" } },
    },
    {
      "id": "place.union_hall", "key": "union_hall", "name_key": "place-union_hall",
      "actions": ["lobby", "trade_favor"],
      "services": ["overheard"],
      "layout": { "slot": "community", "footprint": [[4, 3], [5, 4]], "place": ["near_place:factory", "near_place:mine", "central"], "landmark": false, "art": { "kit": "kit.hall", "family": "civic" } },
    },

    // Places with purpose (DEC-079 note): `verbs` of the visit action
    // (actions.jsonc `visit.verbs`); `sector` is the industry a place is part
    // of and `addresses` the concerns its service meets (what the `sector`
    // and `service` grants read). `drivers` are its sector drivers, which
    // policy-family selectors read (DEC-092). Interiors come in later art rounds.
    {
      "id": "place.school", "key": "school", "name_key": "place-school",
      "verbs": ["verb.visit_service", "verb.talk_to_head"],
      "sector": "sector.public", "addresses": ["concern.services"],
      "layout": { "slot": "community", "footprint": [[6, 4], [7, 4]], "place": ["largest_residential", "quiet"], "landmark": false, "art": { "kit": "kit.school", "family": "civic" } },
    },
    {
      "id": "place.clinic", "key": "clinic", "name_key": "place-clinic",
      "verbs": ["verb.visit_service", "verb.talk_to_head"],
      "sector": "sector.public", "addresses": ["concern.services"],
      "layout": { "slot": "community", "footprint": [[4, 3], [5, 4]], "place": ["largest_residential", "arterial"], "landmark": false, "art": { "kit": "kit.clinic", "family": "civic" } },
    },
    {
      "id": "place.park", "key": "park", "name_key": "place-park",
      "verbs": ["verb.be_seen"],
      "layout": { "slot": "green", "footprint": [[3, 2], [3, 2]], "place": ["quiet", "by_water"], "with": ["park"], "landmark": false, "art": { "kit": "kit.park_lodge", "family": "civic" } },
    },
    {
      // Business donors, and the back-and-forth of favours.
      "id": "place.business_association", "key": "business_association", "name_key": "place-business_association",
      "actions": ["lobby", "trade_favor", "fundraise"],
      "layout": { "slot": "commercial", "footprint": [[4, 3], [5, 4]], "place": ["near_square", "central"], "landmark": false, "art": { "kit": "kit.office", "family": "commercial" } },
    },
    {
      "id": "place.factory", "key": "factory", "name_key": "place-factory",
      "verbs": ["verb.tour_works", "verb.listen_at_gate", "verb.photo_op_gate"],
      "sector": "sector.manufacturing", "drivers": ["industrial"],
      "layout": { "slot": "works", "footprint": [[7, 4], [9, 5]], "place": ["near_rail", "by_water", "edge"], "signature": "chimney", "with": ["chimney"], "landmark": true, "art": { "kit": "kit.factory", "family": "industrial" } },
    },
    {
      "id": "place.port", "key": "port", "name_key": "place-port",
      "verbs": ["verb.tour_works", "verb.listen_at_gate", "verb.photo_op_gate"],
      "sector": "sector.manufacturing", "drivers": ["industrial"],
      "layout": { "slot": "harbour", "footprint": [[6, 3], [8, 4]], "place": ["shore", "by_water"], "signature": "cranes", "with": ["pier", "cranes"], "landmark": true, "art": { "kit": "kit.port", "family": "industrial" } },
    },
    {
      "id": "place.farm", "key": "farm", "name_key": "place-farm",
      "verbs": ["verb.walk_fields"],
      "sector": "sector.agriculture", "drivers": ["land_based"],
      "layout": { "slot": "works", "footprint": [[5, 4], [6, 4]], "place": ["edge", "quiet"], "landmark": false, "art": { "kit": "kit.farm", "family": "rural" } },
    },
    {
      "id": "place.mine", "key": "mine", "name_key": "place-mine",
      "verbs": ["verb.tour_works", "verb.listen_at_gate", "verb.photo_op_gate"],
      "sector": "sector.resources", "drivers": ["extraction"],
      "layout": { "slot": "works", "footprint": [[5, 4], [8, 5]], "place": ["edge", "toward:minerals", "near_rail"], "signature": "headframe", "with": ["spoil_heap", "rail_spur", "winding_house"], "landmark": true, "art": { "kit": "kit.colliery", "family": "industrial" } },
    },
    {
      "id": "place.mill", "key": "mill", "name_key": "place-mill",
      "verbs": ["verb.tour_works", "verb.listen_at_gate", "verb.photo_op_gate"],
      "sector": "sector.manufacturing", "drivers": ["industrial"],
      "layout": { "slot": "works", "footprint": [[5, 4], [6, 5]], "place": ["by_water", "riverbank", "edge"], "signature": "chimney", "landmark": true, "art": { "kit": "kit.mill", "family": "industrial" } },
    },
    {
      // A fundraising dinner in the function room, late if need be.
      "id": "place.hotel", "key": "hotel", "name_key": "place-hotel",
      "actions": ["fundraise"],
      "late_night": ["fundraise"],
      "sector": "sector.tourism", "drivers": ["visitor"],
      "layout": { "slot": "commercial", "footprint": [[4, 4], [5, 5]], "place": ["near_square", "by_water", "central"], "landmark": false, "art": { "kit": "kit.hotel", "family": "commercial" } },
    },
    {
      "id": "place.university", "key": "university", "name_key": "place-university",
      "verbs": ["verb.visit_service", "verb.talk_to_head", "verb.meet_young_staff"],
      "sector": "sector.knowledge", "drivers": ["knowledge"], "addresses": ["concern.jobs"],
      "layout": { "slot": "civic", "footprint": [[7, 4], [9, 5]], "place": ["near_square", "high_ground", "quiet"], "signature": "tower", "landmark": true, "art": { "kit": "kit.university", "family": "civic" } },
    },
    {
      // Donors with stock options, and young voters.
      "id": "place.tech_campus", "key": "tech_campus", "name_key": "place-tech_campus",
      "actions": ["fundraise"],
      "verbs": ["verb.meet_young_staff"],
      "sector": "sector.knowledge", "drivers": ["knowledge"],
      "layout": { "slot": "works", "footprint": [[6, 4], [8, 5]], "place": ["edge", "arterial", "by_water"], "landmark": false, "art": { "kit": "kit.campus", "family": "commercial" } },
    },
    {
      // Seats of the tiers above (M7, M8): the public gallery until then.
      "id": "place.regional_assembly", "key": "regional_assembly", "name_key": "place-regional_assembly",
      "verbs": ["verb.public_gallery"],
      "layout": { "slot": "square", "footprint": [[7, 4], [9, 5]], "place": ["on_square", "near_square"], "signature": "dome", "with": ["flag"], "landmark": true, "art": { "kit": "kit.assembly", "family": "civic" } },
    },
    {
      "id": "place.parliament", "key": "parliament", "name_key": "place-parliament",
      "verbs": ["verb.public_gallery"],
      "layout": { "slot": "square", "footprint": [[9, 5], [11, 6]], "place": ["on_square", "near_square"], "signature": "dome", "with": ["flag"], "landmark": true, "art": { "kit": "kit.parliament", "family": "civic" } },
    },
    {
      "id": "place.executive_residence", "key": "executive_residence", "name_key": "place-executive_residence",
      "verbs": ["verb.be_seen"],
      "layout": { "slot": "civic", "footprint": [[7, 4], [9, 5]], "place": ["near_square", "high_ground", "quiet"], "signature": "portico", "with": ["flag"], "landmark": true, "art": { "kit": "kit.residence", "family": "civic" } },
    },
  ],
}
