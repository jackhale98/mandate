// Opinion dynamics (DEC-025, DEC-078 decision 1): how what residents live
// through, and the laws and bills they hear about, move approval of the local
// government and of the player each month. Tune via sweeps; record changes in
// docs/development/BALANCE_LOG.md.
{
  "kind": "opinion",
  "value": {
    // Experienced conditions, in approval units (tanh scale).
    "experience": {
      "unemployment": 12.0,     // per point of local unemployment rise beyond the national rise (a year)
      "unemployment_gap": 6.0, // per point of local unemployment above the nation's, now (the benchmarked level)
      "rent_growth": 2.0,      // per point of real rent growth (a year)
      "services": 1.2,         // per unit of service improvement from laws in effect
      "service_budget": 1.0,   // per unit of the town's budget against what its budget rule aims for (1 = need)
      "disaster": 0.3,         // while a disaster is recent
      "disaster_months": 6,
      "disruption": 1.5,       // per unit of construction disruption
      // What laws deliver now (audit fix 3), from their ledgers' net "added"
      // quantities and what they pay; zero without laws, felt by those reached.
      "delivered": {
        "jobs": 8.0,           // per unit of jobs added over the labour force (working ages)
        "income": 10.0,        // per unit of income paid or raised over the class's income
        "homes": 120.0,        // per unit of homes added in a year over the stock (low and middle classes)
      },
    },
    "policy_reaction": 2.0,        // a bill or law's anticipated reaction per unit of awareness
    "law_reaction_weight": 0.6,    // laws beside experience in government approval
    "gov_approval_rate": 0.08,     // monthly pull of government approval toward its target
    "player_approval_rate": 0.1,   // monthly pull of approval of the player toward reactions to their bills
    "player_reaction_scale": 1.5,

    // Neighbourhood concerns: each district feels its town's indicators
    // through its own residents, homes and surroundings (concerns.jsonc reads
    // the result). Each factor is relative: it is scaled so the residents'
    // mean over the town is 1, leaving the town's own figure where it was.
    // Unemployment comes from the district's income classes (the town's
    // employment rate by class), plus the jobs its workers' sectors have lost
    // beyond the town's average; tax burden and budget stress are the town's
    // everywhere; a recent disaster is felt by how hard it hit (DEC-090 D8).
    "local_concerns": {
      // Rent by district kind; burden is rent over residents' incomes.
      "rent": { "core": 1.15, "inner": 1.1, "waterfront": 1.3, "industrial": 0.8, "suburb": 1.0, "rural": 0.75 },
      "rent_growth": 2.0,              // rent elasticity to growth since play began, against the town
      // Exposure to the region's pollution by district kind, plus industry
      // nearby and the floodplain's runoff.
      "pollution": { "core": 1.0, "inner": 0.8, "waterfront": 0.9, "industrial": 1.6, "suburb": 0.5, "rural": 0.4 },
      "pollution_workplace": 1.0,      // per polluting workplace in the district
      "pollution_next_door": 0.35,     // per polluting workplace next door
      "pollution_floodplain": 0.8,     // × flood exposure (0..1)
      // Which places employ which sector's workers (polluting: industrial, extraction).
      "workplaces": {
        "factory": "industrial", "mill": "industrial", "port": "industrial", "mine": "extraction",
        "farm": "land_based", "hotel": "visitor", "university": "knowledge", "tech_campus": "knowledge",
      },
      "workplace_affinity": 1.5,       // extra share of a sector's workers per workplace in the district (half next door)
      // Extra share of each sector's workers by district kind.
      "sector_kinds": [
        { "driver": "industrial", "kinds": { "industrial": 2.5, "waterfront": 0.3, "rural": 0.2 } },
        { "driver": "extraction", "kinds": { "industrial": 1.0, "rural": 1.5 } },
        { "driver": "land_based", "kinds": { "rural": 4.0 } },
        { "driver": "building", "kinds": { "industrial": 0.6, "suburb": 0.3 } },
        { "driver": "local_services", "kinds": { "core": 0.5, "inner": 0.3 } },
        { "driver": "visitor", "kinds": { "waterfront": 1.5, "core": 0.4 } },
        { "driver": "knowledge", "kinds": { "inner": 0.8, "suburb": 0.5, "core": 0.3 } },
        { "driver": "public", "kinds": { "core": 0.4, "inner": 0.3, "suburb": 0.2 } },
      ],
      "job_loss_decline": 4.0,         // a sector's decline since play began, beside its cyclicality, in who feels job losses
      "jobs_sector_tilt": 1.0,         // share of the jobs a district's sectors lost (beyond the town's) added to its unemployment
      // How the DEC-106 worries read their signals (first guesses, rule 11).
      "signals": {
        "scandal_days": 365,                     // a scandal or conviction counts for a year, fading
        "scandal_gravity": [0.5, 1.0, 1.5],      // ethics, misconduct, crime
        "case_open": 0.5,                        // each open case
        "case_convicted": 1.0,                   // each conviction within the year, fading
        "cost_of_living_class": [1.3, 1.0, 0.6], // low, middle, high: the share that goes on essentials
        "care_children": 1.0,                    // a child's weight in who relies on schools and clinics
        "care_seniors": 1.5,                     // a 65+ resident's
      },
    },
  },
}
