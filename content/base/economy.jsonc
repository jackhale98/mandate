// Economy and demography parameters (REQ-005, DEC-019). Tune here, not in code.
{
  "kind": "economy",
  "value": {
    "inflation_target": 0.02,
    "natural_unemployment": 0.055,
    "neutral_real_rate": 0.01,
    "recession_monthly_chance": 0.011,  // ~2–3 recessions per 30 years (none start during one)
    "recession_depth": [0.05, 0.13],
    "recession_months": [8, 22],
    "commodity_volatility": 0.035,
    "birth_rate": 0.030,
    "death_rates": [0.0003, 0.0008, 0.0015, 0.006, 0.045],
    "migration_rate": 0.004,
    "target_vacancy": 0.05,
    "construction_lag_months": 18,
    "base_dwelling_price": 240000,
    // The town housing market (economy::housing). Rent clears vacancy;
    // households double up as rent takes more of a middle-class income, so
    // incomes bound rent; builders answer price over cost and vacancy. At the
    // target vacancy and the neutral rate, starts equal the baseline.
    "housing": {
      "adults_per_household": 1.9,          // at the reference burden
      "adults_per_household_range": [1.2, 6.0],
      "reference_burden": 0.16,             // a year's rent over a middle-class income
      "headship_elasticity": 0.6,           // adults per household per unit log burden
      "rent_yield": 0.025,                  // a year's rent over the price at the neutral rate
      "risk_premium": 0.035,                // over the real rate in the user cost
      "build_cost_share": 0.85,             // build cost over the starting price
      "rent_response": 0.12,                // monthly rent growth per unit vacancy gap
      "price_adjustment": 0.05,             // monthly share of the gap to the target price
      "demolition_rate": 0.005,             // a year
      "base_growth": 0.004,                 // baseline building beyond replacement, a year
      "starts_price_response": 4.0,         // per unit price over cost
      "starts_vacancy_response": 20.0,      // per unit vacancy below target
      "starts_max": 3.0,                    // × the baseline
      "capped_vacancy_signal": 0.5,         // share of the vacancy signal builders answer while a rent cap binds
    },
    // Borrowing costs (finance::accrue): the tier's spread, plus per_ratio ×
    // (debt over a year's revenue − free_ratio), at most max_extra more. A
    // prudent jurisdiction pays its tier's spread.
    "borrowing": {
      "spreads": [0.012, 0.008, 0.0],       // local, regional, national
      "free_ratio": [0.2, 0.5, 4.0],        // years of revenue owed that lenders ignore (the nation borrows by design)
      "per_ratio": 0.02,
      "max_extra": 0.06,
    },
    // A law's ledger (audit fix 5): direct counts are exact; "added" entries
    // are the direct count × these coefficients, the same for every template
    // (measured on twins by `audit readability`).
    "attribution": {
      "homes_net": 0.6,                     // completed public homes net of the private starts they displace
      "jobs_net": 0.8,                      // sector jobs added per job supported
      "wage_floor_net": 0.65,               // low incomes' rise per unit of wage-floor uplift
    },
    "taxes": {
      "property": 0.009,
      "sales": 0.06,
      "income": [0.08, 0.19, 0.31],
      "business": 0.09,
    },
    "unemployment_replacement": 0.38,
    "pension_replacement": 0.45,
    "tech_growth": 0.02,           // annual technology growth (a scenario may bias it)
    // The era's drift of manufacturing capacity. Each manufacturing industry
    // has its own `trend` (industries.jsonc; their weighted mean is about
    // this); a scenario's era value moves all of them by its difference
    // from this one.
    "manufacturing_trend": -0.008,
    // Industries and named plants (DEC-110): the numbers every industry
    // shares. A plant's margin-adjusted demand is its industry's demand in
    // the town × (1 + its margin + any relief).
    "industries": {
      "short_line": 0.90,           // under this for short_months: short time
      "short_months": 2,
      "full_line": 0.94,            // at or over this for short_months: full time again
      "notice_line": 0.78,          // under this for notice_after_months: a closure notice
      "notice_after_months": 9,
      "notice_months": [4, 9],      // the notice's length: the one draw
      "review_months": 12,          // short time ends in a review after this many months
      "review_line": 0.88,          // at the review, under this: a notice (where the industry closes)
      "review_cut": 0.10,           // else full time again; under full_line it sheds this share of its capacity
      "reprieve_line": 0.84,        // at or over this for reprieve_months before the date: lifted
      "reprieve_months": 2,
      "notice_gap_months": 12,      // one new notice a town in this time, outside a recession
      "small_decay": 0.005,         // monthly loss of unnamed firms while demand is under the notice line
      "min_capacity": 200,          // an industry under this many jobs in a town sheds no firms
      "min_plant": [25, 60, 150, 250],  // smallest named plant: rural, town, city, metro
      "max_town_share": 0.15,       // most of a town's jobs in one plant when it is placed
      "factor_months": 6,           // the average of each demand factor that names the cause
      "trend_months": 120,          // the long average of jobs that anchors supply links
      "link_range": [0.3, 1.5],
      "world_range": [0.6, 1.5],
      "max_industries": [1, 2, 3, 4],   // per split sector: rural, town, city, metro
      "min_share": 0.12,            // a smaller share of the sector folds into the others
      "town_sd": 0.25,
      "boom_line": 1.12,            // a boom: demand over this for boom_months, stock over boom_stock
      "boom_months": 24,
      "boom_stock": 0.3,
      "boom_size": 0.6,             // a reopened pit's size against the one that closed
      "name_forms": [0.45, 0.30, 0.15, 0.10],   // the town, a family, a word, the district
      "works_words": ["Albion", "Phoenix", "Union", "Crown", "Atlas", "Anchor", "Beacon", "Eagle", "Globe", "Star", "Vulcan", "Perseverance", "Providence", "Reliance", "Excelsior", "Hope", "Standard", "Pioneer"],
      "new_plant_margin": 0.05,     // a works opened during a run is the last to go
      "pool_share": 0.5,            // of what idle labour draws while a closed works waits: toward the works
    },
    // Where a hazard falls within a town (DEC-090 D8). A strike's town-wide
    // damage is shared by each neighbourhood's exposure (the flood-prone
    // district takes most of a flood), so the town total is unchanged.
    "hazards": {
      "max_hood_damage": 0.35,  // most of a neighbourhood's homes one strike destroys
      "max_relative": 4.0,      // a neighbourhood's hit is at most 4× the town's average
      "leave_share": 0.25,      // mobile adults leaving for good per unit of damage (as before)
      "temporary_share": 0.75,  // adults staying elsewhere for a while per unit of damage
      "return_rate": 0.12,      // monthly share of them who come home (half in about 5 months)
      "repair_rate": 0.08,      // monthly share of damaged homes repaired
    },
    // Each tier's treasury splits its discretionary budget across the
    // budget categories at the start (DEC-098: data, not code), in order:
    // administration, education, health, safety, infrastructure, social,
    // housing, environment, economic development.
    "treasury_shares": {
      "local":    [0.15, 0.25, 0.0,  0.2, 0.2,  0.05, 0.05, 0.05, 0.05],
      "regional": [0.05, 0.3,  0.35, 0.0, 0.2,  0.0,  0.0,  0.05, 0.05],
      "national": [0.15, 0.1,  0.2,  0.2, 0.15, 0.0,  0.05, 0.05, 0.1],
    },
  },
}
